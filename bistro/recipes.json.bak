    "Ingredients": "[{\"Id\":\"d2a87a4e-d978-4dc2-ac0d-48072be4777a\",\"Name\":\"o ceapa tocata fin\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"d191ab76-e688-44ae-a68c-69087feb8b55\",\"Name\":\"un ardei gras rosu/kapia tocat marunt\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"f6d21b45-fc8c-48fe-809c-b58022bd0085\",\"Name\":\"2-3 catei de usturoi trecuti prin presa/dati pe razatoare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"4d64c5b4-80c6-425e-bba7-78d7663d176a\",\"Name\":\"unt (30g)\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":4},{\"Id\":\"07d0b7c2-e8d9-4912-9961-e903f0310866\",\"Name\":\"ulei de masline\",\"Amount\":3,\"Unit\":\"tbsp\",\"Order\":5},{\"Id\":\"797341a5-69e8-4cfc-8e5b-f9c06a444bcf\",\"Name\":\"o lingura boia afumata\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"2653f99c-5f21-4167-a010-eb841802f513\",\"Name\":\"\\u00BD lingurita fulgi de ardei\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"168955f2-0093-4a8f-9771-496da50625eb\",\"Name\":\"pasta de tomate\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":8},{\"Id\":\"76ae1c25-24f9-4ce2-9507-b971483db4f8\",\"Name\":\"coaja de la o lamaie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"494f70ff-a0de-4da2-919b-04ad4fd9ffc7\",\"Name\":\"o rosie mare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":10},{\"Id\":\"85c6cfb3-ee0e-44a0-923d-76488eb7a3dd\",\"Name\":\"o cana linte rosie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"78b8b2d8-1720-45a0-9f69-800adb3de18f\",\"Name\":\"\\u00BC cana orez\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":12},{\"Id\":\"255dbd04-09b2-4239-b645-951c06dbf726\",\"Name\":\"supa de pui/legume\",\"Amount\":2,\"Unit\":\"litri\",\"Order\":13},{\"Id\":\"d6789022-24f2-435d-b6f3-d3fe8e5a9403\",\"Name\":\"sare si piper dupa gust\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":14}]",
    "Instructions": "[{\"Id\":\"8372c761-976a-4745-8b24-2c122327c444\",\"StepNumber\":1,\"Text\":\"o ceapa tocata fin * un ardei gras rosu/kapia tocat marunt * 2-3 catei de usturoi trecuti prin presa/dati pe razatoare * 2 linguri unt (30g) * 3 linguri ulei de masline * o lingura boia afumata * \\u00BD lingurita fulgi de ardei * 2 linguri pasta de tomate * coaja de la o lamaie * o rosie mare * o cana linte rosie * \\u00BC cana orez * 2 litri supa de pui/legume * sare si piper dupa gust\"},{\"Id\":\"2fa96618-1c82-41fd-ad72-1901b242a500\",\"StepNumber\":2,\"Text\":\"Intr-o oala mare (min 3-4 litri) topim untul alaturi de uleiul de masline. Calim ceapa pana devine translucida, apoi adaugam ardeiul tocat fin si usturoiul, punem sare si piper si le calim pana ardeiul este moale. Tragem de pe foc si adaugam rosia, pe care o curatam de pulpa si samburi si o tocam fin, coaja de lamaie, condimentele, lintea, orezul si pasta de tomate. Amestecam bine si lasam totul pe foc 2-3 minute, la foc mediu, amestecand des. Turnam deasupra supa de pui sau de legume si lasa...\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2209011",
    "LastModified": "2026-01-12 14:15:04.2209011"
  },
