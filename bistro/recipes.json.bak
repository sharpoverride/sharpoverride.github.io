    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"724f07dd-551d-452e-9bc5-9c6293167c37\",\"Name\":\"mici (sau 2 mari)\",\"Amount\":4,\"Unit\":\"mere\",\"Order\":1},{\"Id\":\"949b1a56-ca7d-4055-b270-7d9170fe4ea1\",\"Name\":\"galbenusuri\",\"Amount\":3,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"e01ea22b-7345-47ad-843c-eef6462d65a1\",\"Name\":\"smantana\",\"Amount\":250,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"5060dd00-941d-44b7-b3cc-55a30516c863\",\"Name\":\"unt topit\",\"Amount\":30,\"Unit\":\"g\",\"Order\":4},{\"Id\":\"d41ea1ae-a307-4d00-84d4-54da750813d2\",\"Name\":\"scortisoara\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"ccc5dd31-2d75-42c5-a812-2d17416d116f\",\"Name\":\"nuca macinata\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"95e2d6f7-3b6e-4fbe-9157-a3e16603bae7\",\"Name\":\"zahar optional sau sirop artar\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":7}]",
    "Instructions": "[{\"Id\":\"deb66804-7085-4587-9181-2c1aaa5d36c5\",\"StepNumber\":1,\"Text\":\"4 mere mici (sau 2 mari) * 3 galbenusuri * 250gr smantana * 30gr unt topit * scortisoara * nuca macinata * 1 lg zahar optional sau sirop artar\"},{\"Id\":\"04dfc3ad-1266-4413-ba76-01a2b40ffcd5\",\"StepNumber\":2,\"Text\":\"Se curata merele si se pun in tava 20 min la 180 grade.\"},{\"Id\":\"266a0cad-0c4d-42bf-83a7-40203c48a525\",\"StepNumber\":3,\"Text\":\"Intre timp se amesteca restul ingredientelor si se toarna peste mere cand sunt gata. Se mai dau la cuptor inca 30 de minute.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2173587",
    "LastModified": "2026-01-12 14:15:04.2173587"
  },
  {
