    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"96ead893-1ebe-4873-b592-523542403fbb\",\"Name\":\"prea coapte\",\"Amount\":2,\"Unit\":\"banane\",\"Order\":1},{\"Id\":\"3c6bf3d7-eb81-48da-ab4d-3e4f6042987c\",\"Name\":\"unt topit\",\"Amount\":50,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"feae40a9-b1e0-47b8-a9a1-349d36acec4b\",\"Name\":\"de casa\",\"Amount\":2,\"Unit\":\"oua\",\"Order\":3},{\"Id\":\"b3866b62-e38d-4597-b92f-705191b79b01\",\"Name\":\"Un varf de sare si unul de praf de copt\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"5b62c667-23d6-47f9-8d58-5b58eedc3280\",\"Name\":\"lapte\",\"Amount\":100,\"Unit\":\"ml\",\"Order\":5},{\"Id\":\"45e2dbef-b773-42cb-af63-316570fdfc12\",\"Name\":\"Faina pana se obtine o consitenta ce \\u201Csta pe lingura\\u201D\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6}]",
    "Instructions": "[{\"Id\":\"526f5b5f-0a9c-4ea7-90fd-806646ce2500\",\"StepNumber\":1,\"Text\":\"Ingrediente 2 banane prea coapte 50 gr unt topit 2 oua de casa Un varf de sare si unul de praf de copt 100 ml lapte Faina pana se obtine o consitenta ce \\u201Csta pe lingura\\u201D\"},{\"Id\":\"7d9a604f-ecbe-46e0-811a-38d0e3b6246a\",\"StepNumber\":2,\"Text\":\"Se amesteca toate ingredientele si se aseaza in formele de gogosele.\"},{\"Id\":\"8fa25ed3-e7dd-4898-a677-4d19f865d70a\",\"StepNumber\":3,\"Text\":\"Se adauga cateva fructe congelate si trec rapid la cuptor pt 18 min.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.215141",
    "LastModified": "2026-01-12 14:15:04.215141"
  },
  {
    "Id": "337CBAC1-7D53-4034-8062-BA2F1713BCE8",
