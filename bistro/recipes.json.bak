    "Ingredients": "[{\"Id\":\"0ae7c040-6ae5-4f99-8fdb-42f579d0b5ed\",\"Name\":\"Aluat:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"48d83d33-a665-40b9-a467-860bcced6922\",\"Name\":\"faina\",\"Amount\":200,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"928b3e44-c35e-4930-9bcb-53a90df6c4d4\",\"Name\":\"nuci coapte si macinate\",\"Amount\":60,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"38660ece-fbbf-44ba-ae77-7642a59973d1\",\"Name\":\"zahar\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":4},{\"Id\":\"41363de7-9f1d-4351-932d-dd89797ddea8\",\"Name\":\"sare\",\"Amount\":1,\"Unit\":\"tsp\",\"Order\":5},{\"Id\":\"75f3df98-480e-4e2e-a6d3-76532b824a90\",\"Name\":\"unt rece, taiat cubulete\",\"Amount\":225,\"Unit\":\"g\",\"Order\":6},{\"Id\":\"ecfa0783-a97e-45be-931e-d18327bf542e\",\"Name\":\"4-6 linguri apa rece\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"a72cf1e4-5350-4bc0-b7ed-f9300bcce5c7\",\"Name\":\"Umplutura:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"3d2f1384-646e-498a-9ef6-5c2b43e3b994\",\"Name\":\"-6 mere\",\"Amount\":5,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"1fef8b2e-84a1-4041-a05c-474ae005c2cf\",\"Name\":\"coapte, dar ferme\",\"Amount\":3,\"Unit\":\"pere\",\"Order\":10},{\"Id\":\"0e0eb0ac-4442-4e46-9c87-1bd700c1abc5\",\"Name\":\"\\u00BC lingurita sare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"dcb4dc79-353e-423d-a70c-512df23bf228\",\"Name\":\"zahar\",\"Amount\":120,\"Unit\":\"g\",\"Order\":12},{\"Id\":\"f16db061-eb25-44f8-ae9c-41bea3a5566c\",\"Name\":\"de vanilie\",\"Amount\":1,\"Unit\":\"pastaie\",\"Order\":13},{\"Id\":\"0e21fad1-cc3e-49bc-9088-37218c5661ea\",\"Name\":\"sucul de la \\u00BD lamaie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":14},{\"Id\":\"9dde0502-1f76-4478-ae51-31559113ca0f\",\"Name\":\"unt\",\"Amount\":50,\"Unit\":\"g\",\"Order\":15},{\"Id\":\"f24341e1-a23d-4ba7-aa37-093ad3e97e4f\",\"Name\":\"faina\",\"Amount\":3,\"Unit\":\"tbsp\",\"Order\":16},{\"Id\":\"e0a748df-129f-4708-9e76-7496793d6a7b\",\"Name\":\"batut\",\"Amount\":1,\"Unit\":\"ou\",\"Order\":17},{\"Id\":\"56ded256-95ef-40c7-882b-94dbe8cf367d\",\"Name\":\"zahar fin\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":18}]",
    "Instructions": "[{\"Id\":\"7350a007-0314-4af3-8ef7-d1980c270705\",\"StepNumber\":1,\"Text\":\"Aluat: * 200g faina * 60g nuci coapte si macinate * 1 lingura zahar * 1 lingurita sare * 225g unt rece, taiat cubulete * 4-6 linguri apa rece Umplutura: * 5 -6 mere * 3 pere coapte, dar ferme * \\u00BC lingurita sare * 120g zahar * 1 pastaie de vanilie * sucul de la \\u00BD lamaie * 50g unt * 3 linguri faina * 1 ou batut * 1 lingura zahar fin\"},{\"Id\":\"8c4b3c95-d4d8-4d81-b062-88585c79b9b1\",\"StepNumber\":2,\"Text\":\"Amesteca faina, nucile macinate, zaharul si sarea. Adauga cubuletele de unt si amesteca cu mana, pana cand amestecul devine granulos. Pune cateva linguri de apa rece (nu pe toata) pana cand aluatul incepe sa se lege. Framanta-l de cateva ori cu palmele si imparte-l in doua parti egale. Inveleste-le in folie de plastic si aplatizeaza-le intr-un disc. Pune-le la frigider timp de cel putin 45 de minute. Inainte sa le folosesti scoate-le la temperatura camerei 5-10 minute.\"},{\"Id\":\"c88a6270-ffc4-4c8e-a1c2-da4e89bed983\",\"StepNumber\":3,\"Text\":\"Intinde o parte din aluat pe baltul tapetat cu faina, formand o foaie cu diamentrul de 28cm. Aseaza-o intr-o tava rotunda de placinta cu diametrul de 23cm si si taie marginile lasand 1-2cm in plus.\"},{\"Id\":\"5158bbbc-c3b3-4ac4-ba7e-356c3519f0fc\",\"StepNumber\":4,\"Text\":\"Intinde si cealalta parte de aluat intr-o foaie la fel de mare ca prima si pune-o pe o hartie de copt. Pune-le impreuna la frigider timp de 1 ora.\"},{\"Id\":\"5ed47e5b-30d3-4228-89d1-5dafb58e3b20\",\"StepNumber\":5,\"Text\":\"Pregateste umplutura:**\"},{\"Id\":\"0c0da165-0c32-4d66-9958-0e0f81b948e9\",\"StepNumber\":6,\"Text\":\"Curata merele si perele si taie-le felii groase sau cuburi, indepartand samburii. Amesteca-le cu sare, zahar, miezul de la pastaia de vanilie si sucul de lamaie. Topeste untul intr-o tigaie si caleste fructele la foc mare timp de 5 minute, apoi la foc mediu alte 5 minute pana cand se inmoaie. Pune in tigaie si 3 linguri de faina si lasa pe foc 1 minut. Lasa amestecul sa se raceasca de tot inainte sa il folosesti.\"},{\"Id\":\"4694fb17-e9dd-4f66-8786-0133bfaa4fb5\",\"StepNumber\":7,\"Text\":\"Taie din foaia de aluat intinsa fasii groase din care vei forma o impletitura peste placinta. Pune amestecul cu fructe in tava cu aluat si unge marginile aluatului cu ou batut.\"},{\"Id\":\"cc9cc4c3-e23b-47c1-94f4-b3a4d4d49121\",\"StepNumber\":8,\"Text\":\"Aseaza fasiile de aluat taiate deasupra umpluturii, fara sa lasi spatii prea mari intre ele si apasa-le pe margini sa se lipeasca de partea de jos a aluatului.\"},{\"Id\":\"c1c301ea-869a-47f1-8d00-8410fbc41d34\",\"StepNumber\":9,\"Text\":\"Taie partile in exces si modeleaza pe margine ciupind cu varful degetelor. Unge placinta cu ou batut si presara 1 lingura de zahar fin deasupra. Pune la congelator timp de 30 de minute.\"},{\"Id\":\"57265020-7ce5-4cca-88c3-044f7fa052c5\",\"StepNumber\":10,\"Text\":\"Incinge cuptorul la 220C si pozitioneaza gratarul in jumatatea de jos a cuptorului. Coace placinta timp de 15 minute, apoi redu temperatura la 190C si lasa placinta timp de aproape o ora in cuptor.\"},{\"Id\":\"39ffe49b-5af3-459a-b3f0-2f112bbfc7f8\",\"StepNumber\":11,\"Text\":\"Lasa placinta sa se raceasca inainte sa o tai.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2242181",
    "LastModified": "2026-01-12 14:15:04.2242181"
  },
  {
    "Id": "D58BD13B-5225-4CB2-A307-13B8CB50CA0C",
    "Title": "Pui cu miere si usturoi",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Pui_cu_miere_si_usturoi.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"46a7bfd2-0490-427d-8311-2726ca2fc053\",\"Name\":\"piept pui\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"c300548f-fd22-4111-9840-c09322dfcb3f\",\"Name\":\"1/2 cana sos soia\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"73835d81-cece-4a61-a133-adaf106ebad6\",\"Name\":\"1/2 cana ketchup dulce\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"e01d08fb-b232-40f5-bc9c-a29119f47048\",\"Name\":\"1/2 cana miere\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"2242a7bc-c29d-463e-83ef-6d4628fe5035\",\"Name\":\"de usturoi\",\"Amount\":6,\"Unit\":\"catei\",\"Order\":5},{\"Id\":\"487e806f-7503-4d75-a585-73ddf9fd255d\",\"Name\":\"condimente pui\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"d0e42e3c-d22c-4ece-91bb-5d7efc2554c2\",\"Name\":\"susan si ceapa verde pentru servire\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7}]",
    "Instructions": "[{\"Id\":\"37728777-68c1-478e-b416-0671bd9a54dd\",\"StepNumber\":1,\"Text\":\"2 buc piept pui * 1/2 cana sos soia * 1/2 cana ketchup dulce * 1/2 cana miere * 6 catei de usturoi * condimente pui * susan si ceapa verde pentru servire\"},{\"Id\":\"705e81f9-1263-4944-82f1-e2190e27556f\",\"StepNumber\":2,\"Text\":\"### **MOD DE PREPARARE PUI CU MIERE SI USTUROI LA SLOWCOOKER**\"},{\"Id\":\"a39be148-cbc6-495e-a9e7-4f8ec6f58872\",\"StepNumber\":3,\"Text\":\"1. Taiem carnea cubulete potrivite, de 1\\u00D71 cm. Asezam carnea in vasul slow cooker-ului.\"},{\"Id\":\"c5f4cc1a-df7c-44aa-8c41-8a5b2e008162\",\"StepNumber\":4,\"Text\":\"2. Pregatim sosul din sos de soia, miere, ketchup, condimente pentru pui, usturoiul trecut prin presa. Turnam sosul peste bucatile de carne, amestecam foarte bine.\"},{\"Id\":\"b6c13811-99e7-44c0-a598-a8b0454f8c71\",\"StepNumber\":5,\"Text\":\"3. Setam aparatul pe functia HIGH timp de 3 ore sau LOW 5-6 ore. Nu e nevoie sa verificam sau sa amestecam carnea.\"},{\"Id\":\"bc7e1be4-420d-4fff-8c6d-fd947a91772c\",\"StepNumber\":6,\"Text\":\"4. Cand timpul de gatire a expirat, presaram doua linguri de amidon, amestecam bine si setam aparatul pe functia HIGH 30 min.\"},{\"Id\":\"8839ec53-1b6c-4405-9be0-1178215da64a\",\"StepNumber\":7,\"Text\":\"5. Servim puiul alaturi de orez natur, ceapa verde si, bineintele, presaram susan din abudenta.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2243515",
    "LastModified": "2026-01-12 14:15:04.2243515"
  },
  {
    "Id": "D9A1A274-EB42-4EF8-8384-09F7BC869673",
    "Title": "Pulpe de pui in sos gorgonzola",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Pulpe_de_pui_in_sos_gorgonzola.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"34ffd060-7827-4bbd-967c-7c4e2464d2e2\",\"Name\":\"Condimente la alegere (am folosit condiment Fried chicken care contine: usturoi rumenit, ceapa, paprika, piper negru, mustar, salvie, rozmarin, savory, patrunjel, oregano, )\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"8cd54fbb-d5ca-4c95-83ce-da0ddd5e11e2\",\"Name\":\"fri\\u0219c\\u0103 (smantana lichida)\",\"Amount\":200,\"Unit\":\"ml\",\"Order\":2},{\"Id\":\"7c7a5b89-f747-4f02-9b46-1ba22d1c1ee4\",\"Name\":\"1-2 linguri amidon (in func\\u021Bie de c\\u00E2t de gros vre\\u021Bi sosul)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"d0a13361-b25c-408d-9703-a61f55a2bb32\",\"Name\":\"Gorgonzola (pt copila\\u0219i sub 1 an omiteti)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4}]",
    "Instructions": "[{\"Id\":\"0ad01208-5551-4695-9329-cce755826d0c\",\"StepNumber\":1,\"Text\":\"Condimente la alegere (am folosit condiment Fried chicken care contine: usturoi rumenit, ceapa, paprika, piper negru, mustar, salvie, rozmarin, savory, patrunjel, oregano, ) 200ml fri\\u0219c\\u0103 (smantana lichida) 1-2 linguri amidon (in func\\u021Bie de c\\u00E2t de gros vre\\u021Bi sosul) Gorgonzola (pt copila\\u0219i sub 1 an omiteti)\"},{\"Id\":\"13593917-77a9-4083-9270-f2f19758d8b8\",\"StepNumber\":2,\"Text\":\"Am \\u00EEncins o tigaie antiaderenta f\\u0103r\\u0103 sa adaug ceva \\u00EEn ea \\u0219i am perpelit pulpele de pui (cu piele) pe toate p\\u0103r\\u021Bile. Pe urma am condimentat carnea \\u0219i am a\\u0219ezat-o \\u00EEn vasul multi cooker-ului.\"},{\"Id\":\"53252166-0bb7-4d8d-b3a8-64d7d8cd2180\",\"StepNumber\":3,\"Text\":\"Am turnat apa c\\u00E2t ss ajung\\u0103 la jum\\u0103tatea pulpelor \\u0219i am pornit aparatul pe func\\u021Bia stew(tocan\\u0103) pt 40 minute.\"},{\"Id\":\"322b7b41-8c58-4d40-b408-41e5e8331547\",\"StepNumber\":4,\"Text\":\"Dup\\u0103 ce a expirat timpul am depresurizat manual \\u0219i am pornit func\\u021Bia simmer (fierbere) cu capacul deschis.\"},{\"Id\":\"2fac5b3e-5f38-42a2-9b53-21506af40b08\",\"StepNumber\":5,\"Text\":\"Am diluat amidonul in fri\\u0219c\\u0103 \\u0219i am turnat \\u00EEn oal\\u0103 amestec\\u00E2nd . Am l\\u0103sat sa fiarb\\u0103 pt 5 minute dup\\u0103 care am pus gorgonzola, am amestecat \\u0219i am mai l\\u0103sat sa fiarb\\u0103 pt 2-3 minute.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.224587",
    "LastModified": "2026-01-12 14:15:04.224587"
  },
  {
    "Id": "DB3F4680-8A77-485C-8A3B-F4523E08B929",
    "Title": "Supa de rosii cu zdrente de ou",
    "Description": "O sup\u0103 aromat\u0103 \u0219i reconfortant\u0103, perfect\u0103 pentru orice mas\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Supa_de_rosii_cu_zdrente_de_ou.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "Sup\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"a1b71349-4f1c-4d3a-b8dc-566394e287c5\",\"Name\":\"morcovi\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"d2254a35-9e4c-4b8a-9d44-b6951721729b\",\"Name\":\"ceapa\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"a2376d27-cf27-41d8-9b85-9f6d83ff95c0\",\"Name\":\"ou\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"6e28849f-99db-464a-a4da-a53bf6d80328\",\"Name\":\"pasta de rosii\",\"Amount\":250,\"Unit\":\"ml\",\"Order\":4},{\"Id\":\"90f7ad4b-dc2e-4f7b-b3eb-6c0f5de83f80\",\"Name\":\"apa\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"81c0a574-94a0-48b2-905a-9ff52142a993\",\"Name\":\"cimbru\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"bf2c75df-b26a-452a-bb43-5760816fd41a\",\"Name\":\"busuioc proaspat\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"b27d3963-ea49-4c50-98ea-32e77ca88375\",\"Name\":\"sar, piper, zahar\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8}]",
    "Instructions": "[{\"Id\":\"6b32a2b8-dcd2-488c-9fbe-8cee514806f7\",\"StepNumber\":1,\"Text\":\"2 morcovi * 1 ceapa * 1 ou * 250ml pasta de rosii * apa * cimbru * busuioc proaspat * sar, piper, zahar\"},{\"Id\":\"13a9792d-bdcb-4752-995a-5d6169beaf12\",\"StepNumber\":2,\"Text\":\"Se pun la fiert legumele in apa cu sare. Dupa ce au fiert se scot sau se pot lasa si pisa la final.\"},{\"Id\":\"37922cfa-fcbb-41b9-83de-9c85e637e9a6\",\"StepNumber\":3,\"Text\":\"Se adauga bulionul si un ou batut in fir subtire. Se pune si o lingurita de zahar sa ia din aciditate.\"},{\"Id\":\"3e24fea2-1b59-4558-852f-1e7b1ea64ef7\",\"StepNumber\":4,\"Text\":\"Se presara cimbru proaspat si busuoic proaspat.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.224587",
    "LastModified": "2026-01-12 14:15:04.224587"
  },
  {
    "Id": "DB6F6C71-C21B-4DD5-B950-DE321FA7D7DF",
    "Title": "Tocanita de hribi cu mamaliga",
    "Description": "O re\u021bet\u0103 tradi\u021bional\u0103 rom\u00e2neasc\u0103, preg\u0103tit\u0103 dup\u0103 re\u021beta clasic\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Tocanita_de_hribi_cu_mamaliga.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "Rom\u00e2neasc\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"3e008dd5-70c4-464c-9395-5914564e0a05\",\"Name\":\"Tocanita:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"ddd88a2d-3a38-4df8-8032-1df7972d4bbc\",\"Name\":\"Dou\\u0103 leg\\u0103turi de ceap\\u0103 verde\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"0c2759af-3b58-4ca2-b3bb-7f729d968aeb\",\"Name\":\"de Hribi (congela\\u021Bi)\",\"Amount\":300,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"120890c4-3dde-422c-b9c5-1b8b867c773b\",\"Name\":\"Ghebe (congelate)\",\"Amount\":150,\"Unit\":\"g\",\"Order\":4},{\"Id\":\"c9e9f6bb-45d6-4afc-8ac3-12e4d3140d11\",\"Name\":\"o m\\u00E2n\\u0103 de urechi de lemn\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"32539e4d-be03-4569-8651-8da1aae0dbd8\",\"Name\":\"dou\\u0103 linguri de sm\\u00E2nt\\u00E2n\\u0103 gras\\u0103 (am folosit sm\\u00E2nt\\u00E2n\\u0103 de cas\\u0103, e altceva)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"50b08264-ff5d-4b1f-83ed-1ebe013fa160\",\"Name\":\"leg\\u0103tur\\u0103 frunze de p\\u0103trunjel\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"65add5e9-acad-4552-9b41-b2e97faa18c6\",\"Name\":\"Sare piper\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"3036671a-40e4-4016-9e75-2999ca04f29e\",\"Name\":\"linguri\\u021B\\u0103 past\\u0103 Miso alb\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"6a1259aa-6576-4b34-8448-f449a11a3925\",\"Name\":\"c\\u0103\\u021Bei de usturoi\",\"Amount\":6,\"Unit\":\"buc\",\"Order\":10},{\"Id\":\"dafd9343-1154-47a1-a239-9146cce922f5\",\"Name\":\"ulei de m\\u0103sline\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"55dc2a05-f850-46e5-9b9f-9e792b219a65\",\"Name\":\"o lingur\\u0103 de unt gras\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":12},{\"Id\":\"feb6f5b6-3040-41f4-86d7-d3e17728907c\",\"Name\":\"Mamliga\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":13},{\"Id\":\"ea0ef425-9ccb-49d0-97c7-235f7e4d98e6\",\"Name\":\"de unt\",\"Amount\":50,\"Unit\":\"g\",\"Order\":14},{\"Id\":\"6c0fbe14-c07d-4a45-9565-0353291db8f3\",\"Name\":\"de m\\u0103lai\",\"Amount\":240,\"Unit\":\"g\",\"Order\":15},{\"Id\":\"ba146dfd-0fbf-4dd5-9bf6-bc59e4c4586d\",\"Name\":\"de ap\\u0103 sau sup\\u0103 de legume\",\"Amount\":720,\"Unit\":\"ml\",\"Order\":16},{\"Id\":\"067f976b-8994-451d-aab2-82dedb9d55c6\",\"Name\":\"sm\\u00E2nt\\u00E2n\\u0103 gras\\u0103\",\"Amount\":200,\"Unit\":\"g\",\"Order\":17},{\"Id\":\"94bffe7f-7fcc-4b26-8bca-bb11411cd666\",\"Name\":\"de br\\u00E2nz\\u0103 de burduf\",\"Amount\":200,\"Unit\":\"g\",\"Order\":18}]",
    "Instructions": "[{\"Id\":\"81fc59cf-baa2-4c87-aaf5-4d00ab103176\",\"StepNumber\":1,\"Text\":\"Tocanita: * Dou\\u0103 leg\\u0103turi de ceap\\u0103 verde * 300 g de Hribi (congela\\u021Bi) * 150 g Ghebe (congelate) * o m\\u00E2n\\u0103 de urechi de lemn * dou\\u0103 linguri de sm\\u00E2nt\\u00E2n\\u0103 gras\\u0103 (am folosit sm\\u00E2nt\\u00E2n\\u0103 de cas\\u0103, e altceva) * 1 leg\\u0103tur\\u0103 frunze de p\\u0103trunjel * Sare piper * 1 linguri\\u021B\\u0103 past\\u0103 Miso alb * 6 c\\u0103\\u021Bei de usturoi * ulei de m\\u0103sline * o lingur\\u0103 de unt gras Mamliga * 50g de unt * 240 g de m\\u0103lai * 720 ml de ap\\u0103 sau sup\\u0103 de legume * 200 g sm\\u00E2nt\\u00E2n\\u0103 gras\\u0103 * 200 g de br\\u00E2nz\\u0103 de burduf\"},{\"Id\":\"71d70024-6e2d-48bc-b2c2-7f8d2f858775\",\"StepNumber\":2,\"Text\":\"Mamliga se gateste in cuptor, incepem cu ea. Se tapeteaza un vas de yena cu unt, se pune malai, smantana, supa de legume, sare, piper, si unt si se amesteca bine. Se da la cuptor la 175 grade pentru 30 de minute.\"},{\"Id\":\"e2a82b10-3040-485b-b83a-bfce8c236d78\",\"StepNumber\":3,\"Text\":\"Dupa se adauga branza de burduf, se amesteca bine si se mai baga la cuptor inca 15 min.\"},{\"Id\":\"a706afc7-146c-4b20-ba1c-c88534d19512\",\"StepNumber\":4,\"Text\":\"Urechile de lemn se hidrateaza in apa fierbinte pentru 15 min.\"},{\"Id\":\"e49adadf-a65f-4350-b4ee-73b056edaa55\",\"StepNumber\":5,\"Text\":\"Se toaca ceapa si se caleste la foc mediu in unt si ulei. Ciupercile se toaca. Se pun hribele si ghebele peste ceapa si se lasa 15 minute.\"},{\"Id\":\"742fb28c-42b1-4bb7-83a8-0ad5096b554b\",\"StepNumber\":6,\"Text\":\"Dupa 5 minute se adauga si urechile de lemn. Se adauga si doua linguri se smantana si putin din apa in care au stat urechile de lemn. Se pune si lingura de pasta miso daca se doreste.\"},{\"Id\":\"2494922f-9436-4506-9a6c-d7155d49eb5b\",\"StepNumber\":7,\"Text\":\"Se adauga patrunjel, sare piper.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2248283",
    "LastModified": "2026-01-12 14:15:04.2248283"
  },
  {
    "Id": "DC1A7A85-F27A-476F-A14E-3BE213ED1A04",
    "Title": "Prajitura craiasa zapezii",
    "Description": "Un desert delicios care combin\u0103 savoarea unic\u0103 a ingredientelor \u00eentr-o re\u021bet\u0103 rafinat\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Prajitura_craiasa_zapezii.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "Desert",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"7086ed36-6c00-4d2c-9ee0-4c3fcad62d8d\",\"Name\":\"Blat\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"c12a9224-d5d4-463a-a3cc-60d28532b93b\",\"Name\":\"-6 albu\\u0219uri\",\"Amount\":4,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"a7711ad9-cbb1-4075-b226-e9f89a95c7d0\",\"Name\":\"- 165 grame de zah\\u0103r\",\"Amount\":110,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"8b5e9f16-dd03-4fda-92a3-eb6897aac918\",\"Name\":\"- 125 grame de f\\u0103in\\u0103\",\"Amount\":85,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"2adfbcee-26ee-4453-836e-c0a80c563ab8\",\"Name\":\"o lingur\\u0103 de esen\\u021B\\u0103 de vanilie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"8902c167-4eaf-4f2c-83f8-2f76e1f8daa2\",\"Name\":\"un v\\u00E2rf de cu\\u021Bit cu sare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"03145ab9-4082-4d25-a4b7-6630f3f2bcaa\",\"Name\":\"Crema vanilie/ciocolata\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"7b8d7ddb-0145-4a25-873c-cf7b316a5733\",\"Name\":\"4-6 g\\u0103lbenu\\u0219e\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"4a9d84ea-bfcf-4bac-a2ff-620b67248e4f\",\"Name\":\"400-600 ml lapte dulce\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"ff2df657-5ebc-425d-a21a-d29d02a744ed\",\"Name\":\"120-180 de grame de zah\\u0103r\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":10},{\"Id\":\"6d48e80c-3429-4969-914a-65a038e32790\",\"Name\":\"40-60 grame de f\\u0103in\\u0103 alb\\u0103 de gr\\u00E2u tip 000 (sau 30 de amidon)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"89f9599e-3389-4251-bcf0-3e35aef56bd8\",\"Name\":\"o lingur\\u0103 de esen\\u021B\\u0103 concentrat\\u0103 de vanilie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":12},{\"Id\":\"c918b9e0-e516-492d-af46-f837ad5db690\",\"Name\":\"un v\\u00E2rf de cu\\u021Bit cu sare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":13},{\"Id\":\"ea7e6c06-9002-4501-b1c2-67c60e6cda10\",\"Name\":\"150-225 grame de unt cu 85% gr\\u0103sime - la temperatura camerei\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":14},{\"Id\":\"07cceeba-c1bf-4a8d-af4f-930bb185f0f0\",\"Name\":\"75-105 grame de ciocolat\\u0103 neagr\\u0103\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":15},{\"Id\":\"9a0a4d46-3152-4b6a-8b74-11a147d5c6df\",\"Name\":\"Stratul de biscui\\u021Bi\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":16},{\"Id\":\"ba4137b3-2e48-4e54-9da9-b3221917313e\",\"Name\":\"tip Petit Beurre (aproximativ)\",\"Amount\":12,\"Unit\":\"biscuiti\",\"Order\":17},{\"Id\":\"a981cf31-4b6f-42d3-9c9d-35958b9e2a43\",\"Name\":\"lapte dulce\",\"Amount\":100,\"Unit\":\"ml\",\"Order\":18},{\"Id\":\"96b5315b-299f-4887-be9d-6305d89f3ee4\",\"Name\":\"Stratul de fri\\u0219c\\u0103\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":19},{\"Id\":\"5df8a448-dc8d-4f35-8e50-5b35878028ab\",\"Name\":\"de sm\\u00E2nt\\u00E2n\\u0103 cu 30% gr\\u0103sime\",\"Amount\":400,\"Unit\":\"ml\",\"Order\":20}]",
    "Instructions": "[{\"Id\":\"46be25d2-59e2-44cc-8fb0-c10efd421082\",\"StepNumber\":1,\"Text\":\"Se bat albusele cu sarea si esenta de faina pana devin ferme.\"},{\"Id\":\"0ce89fd7-7f06-4e0b-ad98-6e4bd83167c9\",\"StepNumber\":2,\"Text\":\"Apoi cu o paleta se adauga incet faina.\"},{\"Id\":\"a354a01c-389f-4f8e-b0af-e3f42f5a7acf\",\"StepNumber\":3,\"Text\":\"Se toarna in tava si se da la cuptor pentru 20min la 160o\"},{\"Id\":\"0b647190-d8a5-4340-a327-35f35d3b474c\",\"StepNumber\":4,\"Text\":\"Se pune laptele la fiert si se lasa sa se infuzeze vanilia\"},{\"Id\":\"a776a749-6c01-4f54-ae93-d62d661c198c\",\"StepNumber\":5,\"Text\":\"Separat se bat ouale cu zaharul pana se obtine o spuma alba\"},{\"Id\":\"56a536e4-22b2-4344-b624-0d29dcda1d9f\",\"StepNumber\":6,\"Text\":\"Se adauga treptat faina\"},{\"Id\":\"41157bec-33ec-43ef-9fec-2c17dd1af3a6\",\"StepNumber\":7,\"Text\":\"Apoi se toarna laptele in fir subtire peste oua amestecand incontinuu\"},{\"Id\":\"5fda0654-9046-4a12-ba01-fb3d6cf6dce9\",\"StepNumber\":8,\"Text\":\"Se pune inapoi pe foc pana se ingroasa (tmx-\\u003Efunctia ...)\"},{\"Id\":\"0290d226-59a5-44d9-8383-c2a50bf4b422\",\"StepNumber\":9,\"Text\":\"Asa calda cum este se imparte in doua parti egale\"},{\"Id\":\"21760b46-1beb-4531-ac30-7d41302e226c\",\"StepNumber\":10,\"Text\":\"O parte se acopera cu folie si se lasa la racit, dupa racire se incorporeaza 100gr unt\"},{\"Id\":\"fd244a24-0a77-4d16-a94e-74def7cdca31\",\"StepNumber\":11,\"Text\":\"In a doua jumatate adaugam ciocolata si lasam un pic sa se tempereze apoi o mixam bine pentru omogenizare. Cand se raceste se adauga 50gr unt spumat\"},{\"Id\":\"2e307a1c-c1a1-4e5c-b61d-a950d14dcaed\",\"StepNumber\":12,\"Text\":\"Le lasam sa ajunga la temperatura camerei\"},{\"Id\":\"4905887c-5656-4429-95d0-f8b160ebc553\",\"StepNumber\":13,\"Text\":\"peste blat se pune crema de cicolata\"},{\"Id\":\"1516b9b4-9e4b-4147-964f-e8c5251b2064\",\"StepNumber\":14,\"Text\":\"se pun biscuitii inmuiati in lapte\"},{\"Id\":\"6caa931c-7aeb-4da7-a57d-3d64ff959c97\",\"StepNumber\":15,\"Text\":\"se adauga crema de vanilie\"},{\"Id\":\"45fee161-9036-4461-9cc2-e51fc099fe1f\",\"StepNumber\":16,\"Text\":\"se da la rece cateva ore\"},{\"Id\":\"13e5db36-3bf5-4c8e-894d-8ac7ff2e31bb\",\"StepNumber\":17,\"Text\":\"se decoreaza cu cocos /ciocolata/ce vreti\"}]",
    "ExportedAt": "2026-01-13 04:01:48.8130577",
    "LastModified": "2026-01-13 04:01:48.8130577"
  },
  {
    "Id": "DEBC61DE-DBE4-431E-BFE6-8926C5380461",
    "Title": "Ciorba de sfecla",
    "Description": "O sup\u0103 aromat\u0103 \u0219i reconfortant\u0103, perfect\u0103 pentru orice mas\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Ciorba_de_sfecla.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "Sup\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"d2fe82ea-7d65-4bdd-aafd-8a19395a4f23\",\"Name\":\"sfecla taiata cubulete (am avut 2 sfecle mari)\",\"Amount\":800,\"Unit\":\"g\",\"Order\":1},{\"Id\":\"e16219ec-6bc3-458c-b77a-8b48bcf68818\",\"Name\":\"tocata marunt\",\"Amount\":1,\"Unit\":\"ceapa\",\"Order\":2},{\"Id\":\"81de9f9c-5e96-4279-b2c6-e8955288b43a\",\"Name\":\"gras tocat marunt\",\"Amount\":1,\"Unit\":\"ardei\",\"Order\":3},{\"Id\":\"77c29d9c-0d08-4d4e-8978-16a17b6a378c\",\"Name\":\"dat pe razatoarea mare\",\"Amount\":1,\"Unit\":\"morcov\",\"Order\":4},{\"Id\":\"995c7706-4adb-4fd0-bec8-4514a6038c20\",\"Name\":\"mica data pe razatoarea mare\",\"Amount\":1,\"Unit\":\"gulie\",\"Order\":5},{\"Id\":\"a6370716-3849-4730-b109-43324f141cee\",\"Name\":\"condiment Adio Sare - Legume din gradina (optional)\",\"Amount\":1,\"Unit\":\"lgt\",\"Order\":6},{\"Id\":\"58ad21c4-5295-44a8-8a6f-33e7df1b67f4\",\"Name\":\"cu vb boia, 1 lgt cimbru uscat, 1 praf de chimen\",\"Amount\":1,\"Unit\":\"lgt\",\"Order\":7},{\"Id\":\"ecd87328-433a-49ec-92ec-1d1862b5939d\",\"Name\":\"200-250 g smantana\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"411aac34-a408-4146-9757-5d855d889f32\",\"Name\":\"2-2,5 l apa (orientativ)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"43248e14-04b7-41e4-94fb-bd86c55c3324\",\"Name\":\"O mana de Fidea (optional). Am folosit de la @alto.pasta ca sunt cele mai cele\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":10}]",
    "Instructions": "[{\"Id\":\"bfe84eb5-b485-4ae7-a928-2df99082097a\",\"StepNumber\":2,\"Text\":\"Calim ceapa si ardeiul in apa cu putin ulei.\"},{\"Id\":\"5d13df48-e680-483e-8a0e-3afe927f48d3\",\"StepNumber\":3,\"Text\":\"Cand s-au inmuiat adaugam morcovul si gulia, putina apa si mai calim pana se inmoaie legumele\"},{\"Id\":\"7ba918db-b853-4ac6-8342-39382c3a59c6\",\"StepNumber\":4,\"Text\":\"Urmeaza condimentele, amestecam vreo 30 secunde, apoi vine sfecla si apa si fierbeti pe foc mic sub capac pana e fiiarta sfecla. Eu am fiert la Ninja pe HP, 15 min, QR.\"},{\"Id\":\"645a0a92-c6d7-4f04-a14b-bad249882b08\",\"StepNumber\":5,\"Text\":\"Se adauga fideaua cand sfecla e fiarta si se mai fierbe putin, max 2 min.\"},{\"Id\":\"5ec5e0c2-3f38-435a-af8e-6815946edbb1\",\"StepNumber\":6,\"Text\":\"Smantana se pune intr-un bol incapator si se adauga peste ea cate un polonic de zeama ca sa o aducem la o temperatura apropiata cu cea din oala. Daca o adaugam direct rece se taie/branzeste.\"},{\"Id\":\"5180a8e2-1402-455f-bd30-8426fdf3e351\",\"StepNumber\":7,\"Text\":\"La final se acreste cu ce va place. Eu am acrit-o cu lamaie.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2249746",
    "LastModified": "2026-01-12 14:15:04.2249746"
  },
  {
    "Id": "E2C7D77C-63CD-4A1C-8E6E-4EF3D2F391B2",
    "Title": "Cornulete cu nuca",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Cornulete_cu_nuca.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"2acc0221-27c2-4c8a-a5d7-997522581d06\",\"Name\":\"nuca macinata\",\"Amount\":100,\"Unit\":\"g\",\"Order\":1},{\"Id\":\"785c67a2-26b9-48dc-bb10-c8a822cbf9bc\",\"Name\":\"zahar pudra (\\u002B extra pentru tavalit)\",\"Amount\":100,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"5dce333f-e25d-41c8-9efc-2dfc66b443a2\",\"Name\":\"unt moale (min. 80% grasime)\",\"Amount\":220,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"e9beb9b6-e8fa-4bb5-9700-10be36046a8b\",\"Name\":\"faina\",\"Amount\":300,\"Unit\":\"g\",\"Order\":4},{\"Id\":\"c16f3095-9dcb-422d-8e88-aff50d7d9098\",\"Name\":\"ou\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"cf58f8af-9ebc-4707-80d0-ede31c586098\",\"Name\":\"coaja de lamaie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"6a8fc4be-4e21-47c7-a4cc-8510dc497250\",\"Name\":\"sare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"71359a70-a7fd-4c82-b202-399d84773259\",\"Name\":\"zahar vanilat\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8}]",
    "Instructions": "[{\"Id\":\"8d04fbe6-66e0-4294-9231-2a96cb33c42b\",\"StepNumber\":1,\"Text\":\"100 g nuca macinata * 100 g zahar pudra (\\u002B extra pentru tavalit) * 220 g unt moale (min. 80% grasime) * 300 g faina * 1 ou * coaja de lamaie * sare * zahar vanilat\"},{\"Id\":\"009ca4f2-f738-40e0-a31c-ee4b0811b58c\",\"StepNumber\":2,\"Text\":\"Nuca se prajeste pentru o aroma mai puternica. Dupa ce se raceste se macina.\"},{\"Id\":\"2d7e272d-ed6d-4c57-884a-7f1fcc568b59\",\"StepNumber\":3,\"Text\":\"Se amesteca ingredientele si se formeaza un aluat care se da la frigider pentru 2 ore.\"},{\"Id\":\"b18be838-574f-4ded-b072-8c034abbe68b\",\"StepNumber\":4,\"Text\":\"Apoi aluatul se taie in 4, apoi fiecare bucata din nou in 4, si apoi iarasi in 4. Rezulta 64 de bucati.\"},{\"Id\":\"12da1b58-98a5-43fe-b1cc-c3994c579f6f\",\"StepNumber\":5,\"Text\":\"Fiecare cub se modeleaaza intr-un furserc.\"},{\"Id\":\"0d33318d-1358-4f5b-966a-cab4db57cc2d\",\"StepNumber\":6,\"Text\":\"Se pun in tava si se dau la cuptor pentru 13-14 min la 180grade.\"},{\"Id\":\"670cf13f-8ec5-41b2-b18f-780b1c6b0eff\",\"StepNumber\":7,\"Text\":\"Cand se scot se tavalesc prin zahar asa calde(daca se racesc, zaharul nu se mai lipeste de ele)\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2251856",
    "LastModified": "2026-01-12 14:15:04.2251856"
  },
  {
    "Id": "E3A212FC-A558-420D-9577-3F0730C3BAC3",
    "Title": "Ficatei in sos de rodie",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Ficatei_in_sos_de_rodie.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"99b6356c-4f5a-4fb3-a671-74c76c609520\",\"Name\":\"ficatei de pui\",\"Amount\":800,\"Unit\":\"g\",\"Order\":1},{\"Id\":\"71847e2e-2ac3-4300-a953-c5f95cdb2e8f\",\"Name\":\"ulei de masline\",\"Amount\":6,\"Unit\":\"tbsp\",\"Order\":2},{\"Id\":\"9cf7e3b6-82d0-44a5-9bfe-e29d6d6ee61f\",\"Name\":\"rosii mai mari (majoritatea retetelor nu includ ceapa dar am mancat si asa si mi-a placut mai mult)\",\"Amount\":2,\"Unit\":\"cepe\",\"Order\":3},{\"Id\":\"4608963e-2369-425e-bf73-f1af1a80a9da\",\"Name\":\"5-6 catei de usturoi\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"fb61308c-0051-44cc-86f4-57cc1f6d90e0\",\"Name\":\"6-8 lg sirop de rodie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"e9dc822d-dbe6-432c-aaf2-33092aebec5a\",\"Name\":\"sumac, 1 lgt piper, sare dupa gust\",\"Amount\":2,\"Unit\":\"lgt\",\"Order\":6},{\"Id\":\"d4b00e4c-2cf9-4d65-9e55-28c05ba83ecc\",\"Name\":\"apa\",\"Amount\":2,\"Unit\":\"l\",\"Order\":7},{\"Id\":\"de73c9ef-b063-4df2-b828-4a399a825861\",\"Name\":\"otet\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":8},{\"Id\":\"aa406057-cb9a-4092-bb1d-f833191fa75f\",\"Name\":\"de scortisoara\",\"Amount\":2,\"Unit\":\"batoane\",\"Order\":9},{\"Id\":\"ac556481-6a5f-4e52-a7a3-2cbfd8b4d631\",\"Name\":\"de dafin\",\"Amount\":2,\"Unit\":\"frunze\",\"Order\":10}]",
    "Instructions": "[{\"Id\":\"205d88ee-2aa0-4779-9ac6-e9568dba1ab6\",\"StepNumber\":1,\"Text\":\"800g ficatei de pui * 6 lg ulei de masline 2 cepe rosii mai mari (majoritatea retetelor nu includ ceapa dar am mancat si asa si mi-a placut mai mult) 5-6 catei de usturoi 6-8 lg sirop de rodie 2 lgt sumac, 1 lgt piper, sare dupa gust 2 l apa 1 lg otet 2 batoane de scortisoara 2 frunze de dafin\"},{\"Id\":\"80fc6ff7-81e1-4d00-854b-1176ed86f4d6\",\"StepNumber\":2,\"Text\":\"Punem pe foc apa cu otetul, scortisoara si frunzele de dafin.\"},{\"Id\":\"f354c696-cbcf-4d1e-82b9-f29e2f0a2bf6\",\"StepNumber\":3,\"Text\":\"Intre timp spalam bine ficateii si ii tamponam cu servete de bucatarie. Ii taiem bucatele mici de aprox 3-4 cm. Cred eu ca secretul aromei gustoase sta in faptul ca asa mici se rumenesc mai bine si mai uniform.\"},{\"Id\":\"30cd301c-6697-431a-94a5-e6d91118b4c6\",\"StepNumber\":4,\"Text\":\"Ii adaugam in apa care fierbe si ii lasam pe foc 1-2 min dupa care ii scurgem bine si ii lasam pe servete de bucatarie sa absoarba apa in exces. E important sa fie cat mai uscati cand ii vom gati in tigaie.\"},{\"Id\":\"bed56c5d-d705-41d6-a324-8a7b8f4fa10a\",\"StepNumber\":5,\"Text\":\"Taiem ceapa solzisori si o calin in uleiul de masline, intr-o tigaie bine incinsa. Cand ceapa e usor carameizata, adaugam usturoiul, mai calim 30 de secunde, apoi adaugam ficateii pe care ii sotam la foc mare. In cateva minute ar trebui sa fie frumos rumeniti, usor prajiti.\"},{\"Id\":\"415e3a66-d093-470f-9a52-8f8ec6c6efee\",\"StepNumber\":6,\"Text\":\"In acel moment adaugam siropul de rodie, piperul si sumac si continuam gatirea la foc mare pt inca vreo 3-4 minute. Si gata!\"},{\"Id\":\"bfea6829-2c5a-47a1-913c-baa459bb0cd9\",\"StepNumber\":7,\"Text\":\"De regula in tarile orientale e servit ca mezze insa mie imi place cu orez simplu fiert sau lipii proaspete si salata.\"},{\"Id\":\"f013e35f-8e63-4ee7-a0e2-ad32571fbd3b\",\"StepNumber\":8,\"Text\":\"Ah da, si se stropeste cu putina lamaie inainte de servire. Daca vreti. E bun.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2251856",
    "LastModified": "2026-01-12 14:15:04.2251856"
  },
  {
    "Id": "E3B2EB03-E29D-4AC4-9026-1D0D16A9D6C5",
    "Title": "Ciulama ciuperci",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Ciulama_ciuperci.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"b83af9ae-5d01-451f-b00a-ee7e89738747\",\"Name\":\"ciuperci\",\"Amount\":500,\"Unit\":\"g\",\"Order\":1},{\"Id\":\"99d97bdb-1dcc-4385-84ae-a479ee836d1b\",\"Name\":\"40-50 ml ulei\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"4e739e87-09cc-4394-bf10-c696af5f5bf4\",\"Name\":\"faina\",\"Amount\":90,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"950a9ab7-854b-461a-bff0-df10205a6580\",\"Name\":\"smantana de gatit\",\"Amount\":100,\"Unit\":\"ml\",\"Order\":4},{\"Id\":\"d98a3dc6-6900-4851-8cce-d44679c07588\",\"Name\":\"sare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"29807c6c-a287-40d7-902b-8e1ff1aa3024\",\"Name\":\"patrunjel frunze\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"7f3e6e2c-9c26-42eb-ae8f-96f574d82b58\",\"Name\":\"usturoi\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"6d100e15-523c-4114-b3e3-71112ea1baad\",\"Name\":\"supa concentrat\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8}]",
    "Instructions": "[{\"Id\":\"8fe9b8c9-69b3-4686-a2b4-e8306adf9e65\",\"StepNumber\":1,\"Text\":\"Ingrediente * 500gr ciuperci * 40-50 ml ulei * 90gr faina * 100 ml smantana de gatit * sare * patrunjel frunze * usturoi * supa concentrat\"},{\"Id\":\"e71a76fa-093d-4b80-b060-1f30764eba12\",\"StepNumber\":2,\"Text\":\"1. Se monteaza fluturasul, se adauga ciupercile, sare =\\u003E 12min/100o/vit 1\"},{\"Id\":\"ea557e2a-6517-4cd6-9f03-203615e7d375\",\"StepNumber\":3,\"Text\":\"2. Se scot ciupercile si fluturele, peste se pune faina =\\u003E 4min/100o/vit 3\"},{\"Id\":\"a4482873-60da-4707-b160-eeda0fea5707\",\"StepNumber\":4,\"Text\":\"3. Se pune supa concentrat aprox 1l=\\u003E 12-15min/90o/vit 4 Spre sfarsitul timpului se adauga smantana\"},{\"Id\":\"b0ccf641-7858-4d59-aa7e-ed21f08dff11\",\"StepNumber\":5,\"Text\":\"4. Se adauga ciuperciule =\\u003E 3min/vit 1 sens invers\"},{\"Id\":\"bf174c3a-12e6-4ec2-b12f-e06bd1ab9e0a\",\"StepNumber\":6,\"Text\":\"5. Se adauga patrunjel tocat si se serveste cu mamaliguta\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2256345",
    "LastModified": "2026-01-12 14:15:04.2256345"
  },
  {
    "Id": "E548D4E8-B2C7-47B8-8EE7-A3C781FE0F0F",
    "Title": "Chicken nuggets",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Chicken_nuggets.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"eb383961-1399-4f97-8841-cdd5afc70dcc\",\"Name\":\"pui\",\"Amount\":1,\"Unit\":\"piept\",\"Order\":1},{\"Id\":\"8c15cb99-5219-416a-aa07-4ae6e251b70c\",\"Name\":\"fiert\",\"Amount\":1,\"Unit\":\"cartof\",\"Order\":2},{\"Id\":\"fd940f4d-8220-40a3-b01f-1ded25e252a6\",\"Name\":\"jumatate de ceapa rosie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"01a50143-e0f4-4405-9501-127a8f7ff882\",\"Name\":\"ou\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"39bdb223-9498-4548-8da0-3a7787b3b816\",\"Name\":\"faina\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"6caacaf6-3aa8-4ba1-be3b-7fc50d0042cf\",\"Name\":\"sare piper\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6}]",
    "Instructions": "[{\"Id\":\"44177fb5-e86e-4e2b-9d28-510c2f846e4f\",\"StepNumber\":1,\"Text\":\"1 piept pui * 1 cartof fiert * jumatate de ceapa rosie * 1 ou * faina * sare piper\"},{\"Id\":\"d90d4e56-573c-4de4-87c6-97b0c144ba71\",\"StepNumber\":2,\"Text\":\"Se dau toate in blender. Se formeaza, se stropesc cu ulei si se pun in air fryer pentru 20 min la 200 de grade. Se intorc la jumatatea timpului.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2256345",
    "LastModified": "2026-01-12 14:15:04.2256345"
  },
  {
    "Id": "E58FE451-434B-40DA-B8F3-6D47CF27C485",
    "Title": "Chiftelute din piure",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Chiftelute_din_piure.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"ee228985-fd43-4a6a-a823-64a136182117\",\"Name\":\"piure (cartofi fier\\u021Bi)\",\"Amount\":250,\"Unit\":\"g\",\"Order\":1},{\"Id\":\"e7b53b91-1414-4a05-91f9-521aa33f6975\",\"Name\":\"ca\\u0219caval ras, cu continut redus de sare;\",\"Amount\":80,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"50ff6158-0f44-41c8-9fee-f94bc08594c0\",\"Name\":\"f\\u0103in\\u0103;\",\"Amount\":60,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"5829ae3e-dae7-4977-a8a5-923d87f068e0\",\"Name\":\"1/2 de linguri\\u021B\\u0103 de curcuma; (op\\u021Bional)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"6b3992dd-b19b-4fa2-8550-4389f27bdccc\",\"Name\":\"ou;\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"253bacc6-2bcc-472c-856a-0899caab9ef7\",\"Name\":\"g\\u0103lbenu\\u0219 pentru uns;\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"26e130fc-ec2a-4707-b7bd-fe6a485e1994\",\"Name\":\"Un praf de boia de ardei dulce;\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"660c3c93-f49a-4fb6-8fba-5ca135d6842f\",\"Name\":\"Semin\\u021Be de susan. (Decor, optional)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8}]",
    "Instructions": "[{\"Id\":\"f30d62f9-9c2d-4380-ad09-df5141fd3c29\",\"StepNumber\":1,\"Text\":\"250 g piure (cartofi fier\\u021Bi) 80 g ca\\u0219caval ras, cu continut redus de sare; 60 g f\\u0103in\\u0103; 1/2 de linguri\\u021B\\u0103 de curcuma; (op\\u021Bional) 1 ou; 1 g\\u0103lbenu\\u0219 pentru uns; Un praf de boia de ardei dulce; Semin\\u021Be de susan. (Decor, optional)\"},{\"Id\":\"21f55bbf-1a43-4f33-98dc-c159fc78149c\",\"StepNumber\":2,\"Text\":\"Am pus ingredientele: piureul, oul, f\\u0103ina, curcuma (pentru culoare) \\u0219i ca\\u0219cavalul ras \\u00EEntr-un bol, apoi am omogenizat amestecul de m\\u00E2na. Rezult\\u0103 nu aluat moale \\u0219i lipicios, a\\u0219a trebuie s\\u0103 fie, nu ad\\u0103uga\\u021Bi f\\u0103in\\u0103 \\u00EEn plus.\"},{\"Id\":\"fb7513eb-da23-4416-9cc9-01f50dc4a25e\",\"StepNumber\":3,\"Text\":\"Am tapetat tava cuptorului cu h\\u00E2rtie de copt, apoi, cu m\\u00E2inile umezite, am format bilu\\u021Be de aluat pe care le-am a\\u0219ezat regulamentar.\"},{\"Id\":\"efcfedad-13f0-40a4-b416-09ee8d2d8697\",\"StepNumber\":4,\"Text\":\"Am uns bilu\\u021Bele de aluat cu g\\u0103lbenu\\u0219 de ou amestecat cu boia de ardei dulce, apoi am pres\\u0103rat semin\\u021Be de susan peste ele.\"},{\"Id\":\"6209f3b6-b993-4027-957e-4b302aee2374\",\"StepNumber\":5,\"Text\":\"Am copt chiftelu\\u021Bele pentru 20-22 de minute, la cuptorul pre\\u00EEnc\\u0103lzit, la 190 de grade.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2257113",
    "LastModified": "2026-01-12 14:15:04.2257113"
  },
  {
    "Id": "E5B08346-C4F5-415F-8117-D7C8A8E1747D",
    "Title": "Spuma capsuni preparata termic",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Spuma_capsuni_preparata_termic.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"443c7c5f-93cb-469f-8e8e-cbdf9425d8ef\",\"Name\":\"de ou\",\"Amount\":2,\"Unit\":\"albuse\",\"Order\":1},{\"Id\":\"d8888020-36d2-4f3d-a373-eba72e5c7052\",\"Name\":\"piure de capsuni (pot si congelati sau proaspeti)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"c99ae4df-d897-416a-b19d-b6df74f98eec\",\"Name\":\"zahar praf\",\"Amount\":50,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"e2e560ea-9bdf-446e-8fda-0a0e8a3d265a\",\"Name\":\"Montat fluturasul, puse ouale si zaharul 7min/vit 4\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"1757a036-00f5-4f55-8e67-4a77a04b9839\",\"Name\":\"Se scote fluturele si se da spuma in jos - 12min/70grade/vit 4\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"a0788076-b36b-4f54-9037-5845ef24d025\",\"Name\":\"In ultimele 2 minute se adauga piureul de capsuni.\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6}]",
    "Instructions": "[{\"Id\":\"dd6d4f2e-d925-41b4-a491-d6e051643f63\",\"StepNumber\":1,\"Text\":\"2 albuse de ou * piure de capsuni (pot si congelati sau proaspeti) * 50 gr zahar praf Montat fluturasul, puse ouale si zaharul 7min/vit 4 Se scote fluturele si se da spuma in jos - 12min/70grade/vit 4 In ultimele 2 minute se adauga piureul de capsuni.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2257511",
    "LastModified": "2026-01-12 14:15:04.2257511"
  },
  {
    "Id": "E68FE1A5-81A4-45DC-B86A-879989C6E733",
    "Title": "Cartofi cu mozzarella la cuptor",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Cartofi_cu_mozzarella_la_cuptor.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"bf9d05ca-4ef9-45fa-a6f0-bb51e5174bca\",\"Name\":\"4-5 cartofi\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"897c19fd-03ec-45ea-beb6-6e1cd21dc580\",\"Name\":\"masline\",\"Amount\":4,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"ebd7ddec-2e83-4bcf-bc85-4076bc39be5c\",\"Name\":\"sunca\",\"Amount\":4,\"Unit\":\"felii\",\"Order\":3},{\"Id\":\"ce8cc46b-2570-4dbf-88c1-009d92439c79\",\"Name\":\"smantana\",\"Amount\":100,\"Unit\":\"ml\",\"Order\":4},{\"Id\":\"34fd8bb1-a81a-4f53-8ecb-66fb96296469\",\"Name\":\"ou\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"b4cc3bae-45ba-43c8-a6ef-2be7cbbad4d0\",\"Name\":\"mozzarella (125 gr)\",\"Amount\":1,\"Unit\":\"bila\",\"Order\":6},{\"Id\":\"74e1c7c4-5616-4c79-9524-9fcaca84a400\",\"Name\":\"sare si piper\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7}]",
    "Instructions": "[{\"Id\":\"cfacc88e-3c6f-49c5-9f7c-c7e6b1b5d2b0\",\"StepNumber\":1,\"Text\":\"4-5 cartofi * 4 masline * 4 felii sunca * 100 ml smantana * 1 ou * 1 bila mozzarella (125 gr) * sare si piper\"},{\"Id\":\"3dc0245c-575b-4535-9407-db5c926e56cb\",\"StepNumber\":2,\"Text\":\"Cartofii curatati, spalati si taiati cubulete, ii fierbem in apa cu putina sare. Nu trebuie sa fie fierti foarte tare pentru a nu se zdrobi, cand intra furculita in ei sunt ok.\"},{\"Id\":\"e0a5976a-b0a7-45cb-ad43-e5235935b4cc\",\"StepNumber\":3,\"Text\":\"Scurgem cartofii de apa si ii punem intr-o tava mica de ceramica sau orice alt vas rezistent la caldura.\"},{\"Id\":\"e13a75b0-6f40-4664-b64c-d1906bee9ff1\",\"StepNumber\":4,\"Text\":\"Taiem maslinele si sunca bucatele mici si le punem peste cartofi.\"},{\"Id\":\"2d047e64-d1d0-4cd8-99ba-dad075afbbe7\",\"StepNumber\":5,\"Text\":\"Taiem si cateva bucatele din mozzarella si le presaram peste cartofi.\"},{\"Id\":\"4d3012ef-a59c-4d71-9f86-a5c3e6161696\",\"StepNumber\":6,\"Text\":\"Smantana o amestecam cu oul si o turnam peste cartofi.\"},{\"Id\":\"d2314305-afda-4289-8b1d-8d1eb207789f\",\"StepNumber\":7,\"Text\":\"Punem deasupra felii de mozzarella si dam tava la cuptorul preincalzit la 180 de grade timp de 20-25 de minute. (1 ora in vas de yena)\"},{\"Id\":\"4bf88a12-826d-47a4-b866-78544b543531\",\"StepNumber\":8,\"Text\":\"Scoatem din cuptor si servim mancarea calda. cu salata\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2257921",
    "LastModified": "2026-01-12 14:15:04.2257921"
  },
  {
    "Id": "E887B4BD-FC2A-42B0-A4F9-2E5B634DCEA3",
    "Title": "Lasagna cu hribi si spanac",
    "Description": "Un clasic italian autentic, plin de gust \u0219i tradi\u021bie culinar\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Lasagna_cu_hribi_si_spanac.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "Italian\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"621f3240-fe1a-4f1a-8934-6e8fff9f635d\",\"Name\":\"Sos bechamel:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"d3820ebc-406a-4aae-8c3e-92c54fa4ccbf\",\"Name\":\"unt se pune intr-o cratita la topit, pe aragaz.\",\"Amount\":50,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"21e6fbbf-ef71-47de-9838-7a6cb30e7cd1\",\"Name\":\"de faina se adauga cand untul e topit si se amesteca cu telul pt 1 min, dupa care se ia de pe foc si\\u2026\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":3},{\"Id\":\"e2d0abbf-7cf8-4c6a-86bb-7f32c9bf2838\",\"Name\":\"lapte rece se toarna incet si treptat peste faina cu unt si se amesteca bine cu telul. Apoi se pune din nou pe foc mic amestecand din cand in cand pana se ingroasa\",\"Amount\":500,\"Unit\":\"ml\",\"Order\":4},{\"Id\":\"82dfb525-5401-4032-a166-f691c0f19934\",\"Name\":\"La final se adauga 50g parmezan razuit, sare, piper si putina nucsoara\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"18be9887-9445-42df-b453-5af2bd97cc6d\",\"Name\":\"Sos cu hribi \\u0026 spanac\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"cd725787-1724-40ce-be89-f60f021974b7\",\"Name\":\"se caleste in ulei de masline cu putina apa. Se adauga 3 catei de usturoi tocati\",\"Amount\":1,\"Unit\":\"ceapa\",\"Order\":7},{\"Id\":\"4d1b4b76-b7ab-43d3-94e3-8a9b17b1f722\",\"Name\":\"de baby spinach se adauga peste ceapa si se soteaza doua minute dupa care\",\"Amount\":1,\"Unit\":\"caserola\",\"Order\":8},{\"Id\":\"7f99062a-7b2b-415a-b77e-5c5156f70edd\",\"Name\":\"de hribi congelati se adauga in tigaie, iar apoi\",\"Amount\":400,\"Unit\":\"g\",\"Order\":9},{\"Id\":\"5a7b1dba-f13e-4f5c-bff3-6ea325205213\",\"Name\":\"(2x380g) de rosii decojite si taiate cubulete si se gateste la foc mediu apre mare cam 20 min sau pana sosul nu mai e apos.\",\"Amount\":2,\"Unit\":\"conserve\",\"Order\":10},{\"Id\":\"b5ca92ef-456a-46b2-b77a-b48663314753\",\"Name\":\"Se condimenteaza cu sare (2 ani\\u002B), piper si busuioc\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"fb880cfe-e2af-4c3a-a767-0681bea7a711\",\"Name\":\"Vom mai avea nevoie de foi de lasagna (am folosit in jur de 250-300g), aprox 150g-200g mozzarella si extra 50g parmezan\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":12}]",
    "Instructions": "[{\"Id\":\"13b10a8f-8771-4ae4-8dd5-dcd405d8cfaf\",\"StepNumber\":2,\"Text\":\"Intr-o tava adanca pt cuptor ( a mea era de 20x30 ) se intinde un strat de sos bechamel, apoi foi de lasagna sa acopere fundul tavii, dupa care sos de hribi, apoi din nou sos bechamel, cateva bucatele de mozzarella apoi iar foi de lasagna si repetati. La final trebuie sa acoperiti ultimul strat de foi de lasagna cu sos bechamel, mozzarella si parmezanul razuit.\"},{\"Id\":\"63838b73-fe2b-4d2d-9696-da65ef640f86\",\"StepNumber\":3,\"Text\":\"Foile sa nu le opariti inainte ca nu e nevoie. Se vor gati daca le acoperiti uniform cu sos si nu suprapuneti mai multe foi de lasagna fara sos intre ele.\"},{\"Id\":\"b6e8e3a7-023e-4bb7-b337-d64d37dbb7b2\",\"StepNumber\":4,\"Text\":\"Se acopera tava si se coace la 180 grade pt 25-30 min apoi descoperita, la 200 grade pt 10 min.\"},{\"Id\":\"9895bc0f-f759-4d7b-aa1c-9e1ae01f6e22\",\"StepNumber\":5,\"Text\":\"O lasati sa respire 10 min dupa care o puteti felia.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2259451",
    "LastModified": "2026-01-12 14:15:04.2259451"
  },
  {
    "Id": "EADBEAAC-C2F5-4A72-A513-6AC1C3EE430F",
    "Title": "Tarta cu ceapa caramelizata si branzeturi",
    "Description": "O re\u021bet\u0103 rafinat\u0103 fran\u021buzeasc\u0103, elegant\u0103 \u0219i delicioas\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Tarta_cu_ceapa_caramelizata_si_branzeturi.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "Francez\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"5f5384f8-4560-4fbc-9752-7ab457524184\",\"Name\":\"Aluat**:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"5942f04f-7eb7-4aae-9c07-3100603ef3d4\",\"Name\":\"faina\",\"Amount\":250,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"1b0718ba-3564-41cb-859b-022b2e4ad83d\",\"Name\":\"unt rece\",\"Amount\":175,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"db5ff940-b710-4ffb-b85c-3592f9dba54f\",\"Name\":\"galbenus\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"df66b814-30cc-40c3-9fc2-7dac131b2039\",\"Name\":\"apa rece\",\"Amount\":40,\"Unit\":\"ml\",\"Order\":5},{\"Id\":\"a8d65ce7-5910-45c9-8389-270b0361cc50\",\"Name\":\"Putina sare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"21176168-a9c2-446e-8f39-ef0f0523f0ea\",\"Name\":\"Umplutura**:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"f142b47d-984f-469b-8615-6e95eab32a9c\",\"Name\":\"rosii mici spre medii\",\"Amount\":3,\"Unit\":\"cepe\",\"Order\":8},{\"Id\":\"57fa0182-6c47-46d8-99a9-bfb5750b0fe3\",\"Name\":\"de miere (1 an\\u002B) sau sirop de curmale\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":9},{\"Id\":\"67b8691f-51e3-4db4-a5c5-5562abed4725\",\"Name\":\"Aprox 400g mix de branzeturi de la @traditia\\\\_laptelui (telemea de bivolita, cas, branza de burduf si cascaval)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":10},{\"Id\":\"79972255-09b1-4a4f-bc3a-30c6925d5770\",\"Name\":\"Albusul ramas de la aluat\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"1ee55f51-ca6e-47cf-bcaa-8241f6ba63a0\",\"Name\":\"rasa de chimen macinat \\u002B extra seminte de chimen\",\"Amount\":1,\"Unit\":\"lgt\",\"Order\":12}]",
    "Instructions": "[{\"Id\":\"efaf1595-f749-4938-a1a8-1acd9e7641ec\",\"StepNumber\":2,\"Text\":\"Aluatul il fac in robotul de bucatarie. Merge si de mana. Amestecam untul cu faina pana obtinem aluat nisipos apoi adaugam galbenusul si apa. Se framanta doar pana se leaga ingredientele.\"},{\"Id\":\"5e9dcd38-b135-45c3-83af-71e9d9e263e8\",\"StepNumber\":3,\"Text\":\"Mi-am dorit sa aiba tarta forma dreptungiulara insa nu am avut tava potrivita asa ca am intins aluatul si l-am decupat astfel incat sa iasa sub forma dorita (vezi poze).\"},{\"Id\":\"5837276e-7424-4cdb-bdbd-3006e514070a\",\"StepNumber\":4,\"Text\":\"Se da aluatul la rece pana se intareste (max 30 min), se gaureste cu furculita si se coace la cuptorul preincalzit la 180 grade pt 20 de min. Se pune o greutate pe aluat la coacere ca sa nu creasca. Eu am pus o tava de chec umpluta cu putina apa.\"},{\"Id\":\"6a346bbf-94b3-4d0a-b34c-c9df911e9a81\",\"StepNumber\":5,\"Text\":\"Pana aluatul sta la rece si se coace, se pregateste ceapa. Intr-o tigaie se pune la calit in putin ulei cu apa ceapa taiata solzisori. Se lasa la gatit pefoc mediu. Cand e moale se mareste focul, se adauga mierea si se continua gatirea pana devine lipicioasa si usor caramelizata.\"},{\"Id\":\"7acacd8f-4863-4fa4-99de-4f22aab756a2\",\"StepNumber\":6,\"Text\":\"Branzeturile se razuiesc si se amestesca cu albusul batut putin si chimenul macinat. Se toarna amescul de brazeturi in crusta de tarta, se aseaza ceapa caramelizata deasupra, se presara chimen seminte si se coace din nou vreo 20 min tot la 180 grade.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2263153",
    "LastModified": "2026-01-12 14:15:04.2263153"
  },
  {
    "Id": "EC645937-1664-4B2B-B855-B5D410A87D5E",
    "Title": "Crema creveti",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Crema_creveti.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"2b22b1ac-570e-44bc-98b2-0587035665c5\",\"Name\":\"creveti Ocean Sea\",\"Amount\":300,\"Unit\":\"g\",\"Order\":1},{\"Id\":\"8e140f6e-a612-4aa0-aa38-74e3167d3276\",\"Name\":\"crema de branza natur Goldessa\",\"Amount\":200,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"c0183a12-b61b-414a-9c06-e23b889ef773\",\"Name\":\"smantana dulce Pilos\",\"Amount\":100,\"Unit\":\"ml\",\"Order\":3},{\"Id\":\"58c1c20a-7e24-4438-b80b-dd90afedad2b\",\"Name\":\"ceapa verde\",\"Amount\":3,\"Unit\":\"fire\",\"Order\":4},{\"Id\":\"789a005c-cb56-44c8-a7d3-98af906e8e16\",\"Name\":\"\\u00BD legatura patrunjel\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"ceb12f3d-d804-4520-9cda-56040e868f82\",\"Name\":\"\\u00BD ardei rosu taiat cubulete\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"68b762b2-f1e2-4fbb-bce6-f13657916104\",\"Name\":\"o lingura sos chili dulce Vitasia\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"907cecd8-4a6c-4e2d-8ca9-bdb2842b71e7\",\"Name\":\"o lingur\\u0103 ulei de masline\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"d16947df-440a-4ffc-ab84-b58d9654a3d6\",\"Name\":\"de usturoi\",\"Amount\":2,\"Unit\":\"catei\",\"Order\":9},{\"Id\":\"b39de390-aca0-4836-92f7-b4ec2506bb95\",\"Name\":\"sare si piper dupa gust\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":10}]",
    "Instructions": "[{\"Id\":\"437990f5-d9d9-41c1-bba9-63fa3668159e\",\"StepNumber\":1,\"Text\":\"300g creveti Ocean Sea * 200g crema de branza natur Goldessa * 100ml smantana dulce Pilos * 3 fire ceapa verde * \\u00BD legatura patrunjel * \\u00BD ardei rosu taiat cubulete * o lingura sos chili dulce Vitasia * o lingur\\u0103 ulei de masline * 2 catei de usturoi * sare si piper dupa gust\"},{\"Id\":\"a33a01b9-dc28-44c4-a557-b98e6911aee4\",\"StepNumber\":2,\"Text\":\"Crevetii se prajesc intr-o tigaie impreuna cu uleiul si usturoiul. Nu mult, numai cat sa prinda culoare/sa se aaromatizeze.\"},{\"Id\":\"1f2dcc57-d670-40fa-a150-75ec3bd68f65\",\"StepNumber\":3,\"Text\":\"Apoi intr-un blender am pus toate ingredientele (mai putin patrunjelul) si le-am tocat marunt. Am adaugat patrunjel proaspat taiat.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2264992",
    "LastModified": "2026-01-12 14:15:04.2264992"
  },
  {
    "Id": "EFAF8E89-0533-4817-B1E8-2B9014B63784",
    "Title": "Rulada cu banane",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Rulada_cu_banane.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"3cdeb397-bf79-45ea-91bf-5db6bccb207b\",\"Name\":\"ou\\u0103\",\"Amount\":4,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"21ff76d0-7215-420d-a7e4-cccd6611111d\",\"Name\":\"de zah\\u0103r\",\"Amount\":4,\"Unit\":\"tbsp\",\"Order\":2},{\"Id\":\"f4cc3e2b-f104-4bc1-9aed-7d3c55bfd5ce\",\"Name\":\"1/2 linguri f\\u0103in\\u0103\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"2b24c0bc-646e-4c2d-bd9c-010c86134a70\",\"Name\":\"1/2 lingur\\u0103 cacao\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"6cbcd4e1-df1b-43ac-a876-2f3dcb2cf8ed\",\"Name\":\"1/2 linguri\\u021B\\u0103 praf de copt\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"6b6a101c-25bb-404a-b3a3-bf154c7f06f2\",\"Name\":\"mascarpone\",\"Amount\":200,\"Unit\":\"g\",\"Order\":6},{\"Id\":\"4ee45bac-3f93-485a-9739-4a8e0e91441a\",\"Name\":\"sm\\u00E2nt\\u00E2n\\u0103 pentru fri\\u015Fc\\u0103\",\"Amount\":200,\"Unit\":\"ml\",\"Order\":7},{\"Id\":\"7823bf40-22ae-4a09-81f1-43dce0fe6a1d\",\"Name\":\"zah\\u0103r pudr\\u0103\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":8},{\"Id\":\"6e2f69ec-f845-4013-85eb-f04d12fe82e3\",\"Name\":\"lingur\\u0103 extract de vanilie (sau o fiol\\u0103 esen\\u021B\\u0103 de vanilie)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"edd2cb0a-70ef-4bad-a4ed-f0632c818bed\",\"Name\":\"banane\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":10}]",
    "Instructions": "[{\"Id\":\"8ee9c592-3433-4b18-bf86-b93591a4a37c\",\"StepNumber\":1,\"Text\":\"Pentru blat** * 4 ou\\u0103 * 4 linguri de zah\\u0103r * 2 1/2 linguri f\\u0103in\\u0103 * 1 1/2 lingur\\u0103 cacao * 1/2 linguri\\u021B\\u0103 praf de copt **Pentru crem\\u0103** * 200 gr mascarpone * 200 ml sm\\u00E2nt\\u00E2n\\u0103 pentru fri\\u015Fc\\u0103 * 2 linguri zah\\u0103r pudr\\u0103 * 1 lingur\\u0103 extract de vanilie (sau o fiol\\u0103 esen\\u021B\\u0103 de vanilie) 2 banane\"},{\"Id\":\"99f937aa-7430-4fb2-ab13-e86beee2a463\",\"StepNumber\":2,\"Text\":\"Se separat oule. Galbenuurile se bat cu zaharul pana isi schimba culoarea.\"},{\"Id\":\"04c7fc7a-1039-44af-9c93-4f9676bc52e0\",\"StepNumber\":3,\"Text\":\"Albusurile se bat spuma cu un pic de sare. Apoi se incorporeaza unele in altele. se adauga faina, praful de copt si cacaoa.\"},{\"Id\":\"3a284de8-b3a1-44f6-a004-69103f765382\",\"StepNumber\":4,\"Text\":\"Se toarna compozitia in tava cuptorului pe hartie de copt si se da la cuptor la 200 grade pentru 10-12 min\"},{\"Id\":\"1f90010c-693a-456b-9363-d11076a5609f\",\"StepNumber\":5,\"Text\":\"Se bate frisca cu mascarponele. Se poate adauga zahar in functie de cat de dulce se doreste.\"},{\"Id\":\"d3a30e3a-2e63-4239-8b67-a110c3e4f71c\",\"StepNumber\":6,\"Text\":\"Se aseaza crema peste foaie, apoi bananele si se ruleaza strans.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2264992",
    "LastModified": "2026-01-12 14:15:04.2264992"
  },
  {
    "Id": "F0159FF4-A4E8-4EE1-B644-3476C8F74BDD",
    "Title": "Cremes",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/placeholder.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"508b3984-4014-4500-adc3-6fc704afecf8\",\"Name\":\"oua\",\"Amount\":8,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"0220c773-939f-4d21-8f98-1d56bd5eabbe\",\"Name\":\"lapte\",\"Amount\":1,\"Unit\":\"l\",\"Order\":2},{\"Id\":\"727e62e5-28d7-4342-b56c-eaf4968ef4ea\",\"Name\":\"zahar\",\"Amount\":250,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"d88d4a6a-6676-48b5-8fef-2728e40ebda9\",\"Name\":\"margarina/unt\",\"Amount\":1,\"Unit\":\"pachet\",\"Order\":4},{\"Id\":\"d71d2bf2-dbef-46fd-8650-1e8f89afd72a\",\"Name\":\"faina\",\"Amount\":12,\"Unit\":\"tbsp\",\"Order\":5},{\"Id\":\"b8dcef52-1ef6-4355-bdd6-b074186a2b9a\",\"Name\":\"zahar vanilat\",\"Amount\":1,\"Unit\":\"plic\",\"Order\":6},{\"Id\":\"73ee1695-49c9-408f-93b6-6ad74db73cf9\",\"Name\":\"zahar pudra\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7}]",
    "Instructions": "[{\"Id\":\"f310704f-3f46-4929-bd9c-4d2d102ff035\",\"StepNumber\":1,\"Text\":\"1 pachet margarina/unt\"},{\"Id\":\"fd75b596-41d6-4e3a-ad3d-4d4aab7c1f41\",\"StepNumber\":2,\"Text\":\"Margarina sau untul se raceste.\"},{\"Id\":\"fdae7005-349f-42bb-b054-f553635aaa24\",\"StepNumber\":3,\"Text\":\"Galenusurile se frecea cu zaharul pana acesta se topeste si se obtine o spuma. Dupa ce s-a racit margarina se pune peste galbenusuri si se amesteca.\"},{\"Id\":\"06f3155d-22ec-44ff-85b8-9a0d4babf152\",\"StepNumber\":4,\"Text\":\"Faina cu 1/2 lapte se amesteca si se pune peste galbenusuri.\"},{\"Id\":\"473ea96f-9739-44d0-87ad-e98a3d41b6ee\",\"StepNumber\":5,\"Text\":\"Albusurile se bat spuma cu plicul de zahar vanilat si se adauga peste galbenusuri.\"},{\"Id\":\"648aa933-decc-40cc-9ff0-d02ff7fb9b04\",\"StepNumber\":6,\"Text\":\"Peste compozitie se adauga restul de lapte, iar apoi se pune totul intr-o tava tapetata cu faina.\"},{\"Id\":\"425b2223-fbd1-4203-981d-1b53fbbc89ea\",\"StepNumber\":7,\"Text\":\"Compozitia se da la cuptor. Cand se scoate se presara zahar vanilat pe deasupra.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2268409",
    "LastModified": "2026-01-12 14:15:04.2268409"
  },
  {
    "Id": "F08BDC13-FBC0-46C5-B6B4-684D26509047",
    "Title": "Rulada de porc cu galbiori",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
