    "Servings": 4,
    "Difficulty": 0,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"429dfce6-7a41-4203-9a27-115d55d4794e\",\"Name\":\"cartof dulce, sfecla fiarta, morcov, telina (pastranc, patrunje, ardei gras, ceapa rosie)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"e665d5e1-66cf-437a-932e-871d5a5cc783\",\"Name\":\"naut\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"e550da77-c67b-414e-822f-d12733daa871\",\"Name\":\"nuci\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"0ad0fa58-2322-4dde-bc8a-7eaa13af8d57\",\"Name\":\"branza feta\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"a47e251c-4ac3-4614-a575-f27e995c0b9c\",\"Name\":\"sos de ulei, patrunjel, usturoi si zeama de lamaie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5}]",
    "Instructions": "[{\"Id\":\"c722b64c-1c83-469e-9405-ccd77bfdfe62\",\"StepNumber\":1,\"Text\":\"cartof dulce, sfecla fiarta, morcov, telina (pastranc, patrunje, ardei gras, ceapa rosie) * naut * nuci * branza feta * sos de ulei, patrunjel, usturoi si zeama de lamaie\"},{\"Id\":\"4d1408f9-4724-4877-8eab-07dd60daece5\",\"StepNumber\":2,\"Text\":\"Legumele se curata si se taie, se pun in tava, se stropesc cu ulei de masline, sar si piper si se dau la cuptor pentru 35-40 min la 180grade\"},{\"Id\":\"5228af70-0779-48c5-babe-d4c53c0eada5\",\"StepNumber\":3,\"Text\":\"Se scot, s epune nautul, nucile, branza si sosul\"}]",
    "ExportedAt": "2026-01-12 14:15:04.222939",
    "LastModified": "2026-01-12 14:15:04.222939"
  },
  {
    "Id": "9A8C6C1B-2A61-4940-9111-9D14BDC1AFA4",
    "Title": "Briose cu dovleac si branza",
    "Description": "O re\u021bet\u0103 delicioas\u0103 \u0219i u\u0219or de preparat, perfect\u0103 pentru orice ocazie. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Briose_cu_dovleac_si_branza.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"9a44473d-f0fd-46bb-893c-1a0787781c22\",\"Name\":\"3/4 cani faina\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"cd9857a5-1669-4ef3-aab5-8377c7a0b201\",\"Name\":\"piure dovleac\",\"Amount\":1,\"Unit\":\"cana\",\"Order\":2},{\"Id\":\"6a54455e-992b-4f70-88a3-c7c8e0e6abd3\",\"Name\":\"zahar\",\"Amount\":1,\"Unit\":\"cana\",\"Order\":3},{\"Id\":\"5abfcce1-dbaa-43bd-9e65-b6c8dde9acf8\",\"Name\":\"1/2 cana zahar brun\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"72b73616-ca08-420b-8955-7273f43a3277\",\"Name\":\"oua\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"10ef87df-5571-4a15-837d-619b59b016fd\",\"Name\":\"1/2 cana ulei\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"df2a8952-61ac-4c79-9101-fbc65e54c2a7\",\"Name\":\"extract vanilie\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":7},{\"Id\":\"3f51ba36-f013-464b-8688-7273d547b128\",\"Name\":\"amestec condimente (nucsoara, scortisoara, ghimbir)\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":8},{\"Id\":\"60f6e50d-8e06-4e55-9dd8-0e4100e41c1f\",\"Name\":\"de copt\",\"Amount\":1,\"Unit\":\"praf\",\"Order\":9},{\"Id\":\"c28c7443-f7f8-4364-9a1d-5fe3e9d19354\",\"Name\":\"sare\",\"Amount\":1,\"Unit\":\"praf\",\"Order\":10},{\"Id\":\"b5e9d8aa-834d-4f1f-b6da-e4bc6cdee39d\",\"Name\":\"Crema de branza\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"9f563cd1-a5fd-4936-822e-8f82a3c3565d\",\"Name\":\"de branza\",\"Amount\":225,\"Unit\":\"crema\",\"Order\":12},{\"Id\":\"ae75d20f-db17-404c-af0a-9815b1d78bca\",\"Name\":\"ou\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":13},{\"Id\":\"79aada10-29e4-4324-b4a8-6cfe3c442bbd\",\"Name\":\"1/4 cana zahar\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":14},{\"Id\":\"a1b55495-2ab2-4dd2-968e-79a96f10d4e5\",\"Name\":\"extract de vanilie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":15}]",
    "Instructions": "[{\"Id\":\"9a147724-48f5-4f43-9e44-9d315acb7eb8\",\"StepNumber\":1,\"Text\":\"1 3/4 cani faina * 1 cana piure dovleac * 1 cana zahar * 1/2 cana zahar brun * 2 oua * 1/2 cana ulei * 1 lg extract vanilie * 1 lg amestec condimente (nucsoara, scortisoara, ghimbir) * 1 praf de copt * 1 praf sare Crema de branza * 225 crema de branza * 1 ou * 1/4 cana zahar * extract de vanilie\"},{\"Id\":\"b95e7ab3-76aa-4c47-b57c-86a93643dd0a\",\"StepNumber\":2,\"Text\":\"1. se amesteca piureul de dovleac cu zaharul. Se adauga oule, uleiul si extractul de vanilie.\"},{\"Id\":\"2f0edf14-4036-4410-bc1a-adfa90f1b06b\",\"StepNumber\":3,\"Text\":\"2. Se adauga amestecul de faina, condimente si praf de copt\"},{\"Id\":\"c73949d9-c13b-4bce-8ee1-b40eb5d3e567\",\"StepNumber\":4,\"Text\":\"3. Se pune amestecul in forme, nu se umplu.\"},{\"Id\":\"31b7eee3-7869-474b-a2c6-44c334632b9b\",\"StepNumber\":5,\"Text\":\"4. Deasupra se adauga din amestecuk de branza\"},{\"Id\":\"b54b5ea0-6825-436c-b70a-9e721ea71adb\",\"StepNumber\":6,\"Text\":\"5. Se amesteca cu o scobitoare\"},{\"Id\":\"48466983-9e35-4be4-a685-b6a060011aa6\",\"StepNumber\":7,\"Text\":\"6. Se coc 18-20 min la 180 grade\"},{\"Id\":\"5bb80be6-240e-4f5d-9db4-b9d268b1cde0\",\"StepNumber\":8,\"Text\":\"7. se lasa sa se raceasca 10 minute inainte de a le scoate\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2229752",
    "LastModified": "2026-01-12 14:15:04.2229752"
  },
