    "CuisineType": "Italian\u0103",
    "IsFavorite": 1,
    "Ingredients": "[{\"Id\":\"28e25cca-17e4-493d-bf76-0d5a8c741b60\",\"Name\":\"Incalzit 75 ml apa\\u00A0 1 min / 37 grade / vit 1\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"1d634973-efa3-484b-a02f-3e002ce85e0f\",\"Name\":\"Drojdia 20 gr sau un pachet uscata\\u00A0 20 sec /vit 2\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"ee7c13da-a35f-4ac0-8296-a8dc11bd2293\",\"Name\":\"Restul ingredientelor : 200 gr iaurt \\u002B 350 gr faina \\u002B o lingurita rasa de sare \\u002B opcional o lingurita or\\u00E9gano 20 sec/ vit 5\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"8cb63bbc-5f5d-409b-b163-a6019b6f1726\",\"Name\":\"Apoi 4 min / spic ( aici am pus 15 ml ulei de masline)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"5cc739be-05d1-449b-a90a-eec8ae7525d8\",\"Name\":\"Se lasa la dospit 25 - 30 min , cat se pregateste topingul care este optiunea fiecaruia.\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5}]",
    "Instructions": "[{\"Id\":\"eada2577-7813-4c8a-9f4d-62d3a081ff27\",\"StepNumber\":1,\"Text\":\"Incalzit 75 ml apa 1 min / 37 grade / vit 1 *\"},{\"Id\":\"8fb363f2-c4b8-4207-a8c7-e22fa2ba3a2d\",\"StepNumber\":2,\"Text\":\"Drojdia 20 gr sau un pachet uscata 20 sec /vit 2 *\"},{\"Id\":\"143bb000-6307-4cff-9287-e6ee6c64e48f\",\"StepNumber\":3,\"Text\":\"Restul ingredientelor : 200 gr iaurt \\u002B 350 gr faina \\u002B o lingurita rasa de sare \\u002B opcional o lingurita or\\u00E9gano 20 sec/ vit 5 *\"},{\"Id\":\"9ca16d5a-cd18-449f-8e00-33bfc5e54398\",\"StepNumber\":4,\"Text\":\"Apoi 4 min / spic ( aici am pus 15 ml ulei de masline) *\"},{\"Id\":\"702bbc8b-2bfb-48c2-b6a8-8389ec89ed18\",\"StepNumber\":5,\"Text\":\"Se lasa la dospit 25 - 30 min , cat se pregateste topingul care este optiunea fiecaruia.\"}]",
