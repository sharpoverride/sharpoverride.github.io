    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"082fb6a8-5ad5-419f-8685-b821edf403a1\",\"Name\":\"fierte (2 oua)\",\"Amount\":3,\"Unit\":\"oua\",\"Order\":1},{\"Id\":\"97666d26-37fc-4555-b20c-ec7ae58fa675\",\"Name\":\"crema de branza\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":2},{\"Id\":\"1ee73d25-192d-4620-bea4-216ed1de5cd5\",\"Name\":\"avocado\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"1bff5ec6-b427-48a0-bd11-0f16f43ef10f\",\"Name\":\"patrunjel din belsug\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"f1d4a9d6-19e5-4ec9-a083-15d2ec7f51c6\",\"Name\":\"sare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"91ded090-ca4e-42e9-a3c1-c846160b884e\",\"Name\":\"bacon\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"d08c7861-9a2d-4986-9fbf-18d52c5b8ab9\",\"Name\":\"rosii pentru servit\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7}]",
    "Instructions": "[{\"Id\":\"3dd5b570-c504-4ed0-99ed-1604da429968\",\"StepNumber\":1,\"Text\":\"3 oua fierte (2 oua) * 1 lingura crema de branza * 1 avocado * patrunjel din belsug * sare * bacon * rosii pentru servit\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2238253",
    "LastModified": "2026-01-12 14:15:04.2238253"
  },
  {
    "Id": "C39BB4B6-054B-4045-9584-281E7534AFFB",
    "Title": "Ciorba de burta falsa",
    "Description": "O sup\u0103 aromat\u0103 \u0219i reconfortant\u0103, perfect\u0103 pentru orice mas\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Ciorba_de_burta_falsa.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "Sup\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"f6b8954b-39a5-4a6e-8211-8c00e19cb490\",\"Name\":\"Ingredinete:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"42466e9a-1b8c-4eff-9c53-206a86371d86\",\"Name\":\"ciuperci pleurotus\",\"Amount\":500,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"f05829c2-1cb5-431e-b948-96f58851e870\",\"Name\":\"mare\",\"Amount\":1,\"Unit\":\"morcov\",\"Order\":3},{\"Id\":\"5b5ca3c2-84c2-4324-abe0-f740758bf55e\",\"Name\":\"ceapa\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"64b7a806-3287-49a7-8457-6619fb916100\",\"Name\":\"pastarnac\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"262726ed-cf87-40c5-ab8b-99fb361b1a0c\",\"Name\":\"rosu kapia\",\"Amount\":1,\"Unit\":\"ardei\",\"Order\":6},{\"Id\":\"43be7b2e-d352-427a-a0e5-a6354186cde9\",\"Name\":\"catei de usturoi (2-3)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"66e0da3d-674e-4622-a58a-7b718d33d5f1\",\"Name\":\"smantana\",\"Amount\":350,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"8c3b021f-6946-403f-a056-01d4e64ca561\",\"Name\":\"galbenuse\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":9}]",
    "Instructions": "[{\"Id\":\"7a96cc51-3ca5-4f27-8a90-e3937b81daee\",\"StepNumber\":1,\"Text\":\"Ingredinete: * 500gr ciuperci pleurotus * 1 morcov mare * 1 ceapa * 1 pastarnac * 1 ardei rosu kapia * catei de usturoi (2-3) * 350 smantana * 2 galbenuse\"},{\"Id\":\"256a9ef0-a47d-4b9a-9feb-13a6e48e565f\",\"StepNumber\":2,\"Text\":\"Pe functia Saute se caleste ceapa taiata marunt, apoi se adauga ardeiul taiat si el marunt si la final se adauga morcovul dat pe razatoare.\"},{\"Id\":\"41e719fa-29d3-4888-894b-632f6a836408\",\"StepNumber\":3,\"Text\":\"Se adauga ciupercile taiate fasii si 2-2.5l apa calda sau fierbinte si se alege functia presiune, HI, 3 min.\"},{\"Id\":\"542bbe9e-c85c-4626-ab31-3d891dab153b\",\"StepNumber\":4,\"Text\":\"Cand se termina se depresurizeaza NR15min.\"},{\"Id\":\"fde6d16b-5edd-4523-84d4-c1b190f41374\",\"StepNumber\":5,\"Text\":\"Intr-un castron se bat galbenusele cu smantana si usturoiul si apoi se adauga treptat cate un polonic de zeama. Cand a ajuns la temperatura ciorbei sa toarna amestecul inapoi in oala. Acum se poate acrii ciorba cu ce va place.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2238253",
    "LastModified": "2026-01-12 14:15:04.2238253"
  },
  {
    "Id": "C65F436E-6756-4941-BF64-3D2274C01205",
    "Title": "Tort raw de mango si fructul pasiunii",
    "Description": "Un desert delicios care combin\u0103 savoarea unic\u0103 a ingredientelor \u00eentr-o re\u021bet\u0103 rafinat\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Tort_raw_de_mango_si_fructul_pasiunii.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "Desert",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"295bae22-825b-46b8-9475-f7cd75ff9dfd\",\"Name\":\"Blat:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"cdb36ef9-004b-41c2-87a0-3359e811adb3\",\"Name\":\"11/4 cani fulgi de cocos\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"1830e499-3e12-4156-85a1-d44e331e0e8a\",\"Name\":\"3/4 cana fulgi ovaz (migdale sau caju)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"f8fa71be-f2d9-46af-9a4e-5c47f6f98194\",\"Name\":\"fara samburi (133gr)\",\"Amount\":8,\"Unit\":\"curmale\",\"Order\":4},{\"Id\":\"7fbe8583-feae-4fd8-9dc4-4420960a0e4f\",\"Name\":\"ulei de cocos\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":5},{\"Id\":\"e6ee96e6-327b-4fd3-8c38-7a5c5a8db41f\",\"Name\":\"coaja de la o lime\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"4ffe30da-bb88-46b0-b2cd-9b4e10435803\",\"Name\":\"un varf de sare de mare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"5519cf3b-157c-474b-883a-5422ae03e87e\",\"Name\":\"Umplutura:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"a3349e32-17b4-41af-917d-218b683bd752\",\"Name\":\"21/4 cani caju inmuiat in apa pentru 2 ore si scurs\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"30bd42eb-bccf-476c-938b-c13eddeda4f1\",\"Name\":\"1/2 cana suc de lamaie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":10},{\"Id\":\"6d84fd5a-cb08-4d19-83f0-05f7c7b19f99\",\"Name\":\"3/4 cana sirop de malt (artar)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"319eb256-f36e-4974-b12d-567c899c3db2\",\"Name\":\"11/2 cani mango proaspat\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":12},{\"Id\":\"4d959d36-c116-4d18-baef-07b2bd58e8ea\",\"Name\":\"1/4 cana pulpa de fructul pasiuii\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":13},{\"Id\":\"0500fbc0-f0ce-41d3-a493-e52c929ad0be\",\"Name\":\"1/2 cana de ulei de cocos\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":14},{\"Id\":\"d0f8cae0-7c2f-40e0-bcc7-929badfe9be6\",\"Name\":\"unt de cacao lichid\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":15},{\"Id\":\"0dbe7284-96c4-4aea-8cee-d4c4332f2c79\",\"Name\":\"Topping:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":16},{\"Id\":\"7847ea4a-aa8b-4bb7-beca-a97275f31dce\",\"Name\":\"Mango, papaya, fructul pasiunii, capsuni, zmeura\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":17}]",
    "Instructions": "[{\"Id\":\"42188ccf-cb8f-466f-8681-d3bf9d83cd65\",\"StepNumber\":1,\"Text\":\"Blat: * 11/4 cani fulgi de cocos * 3/4 cana fulgi ovaz (migdale sau caju) * 8 curmale fara samburi (133gr) * 2 lg ulei de cocos * coaja de la o lime * un varf de sare de mare Umplutura: * 21/4 cani caju inmuiat in apa pentru 2 ore si scurs * 1/2 cana suc de lamaie * 3/4 cana sirop de malt (artar) * 11/2 cani mango proaspat * 1/4 cana pulpa de fructul pasiuii * 1/2 cana de ulei de cocos * 2 lg unt de cacao lichid Topping: * Mango, papaya, fructul pasiunii, capsuni, zmeura\"},{\"Id\":\"bfccafa0-b378-4ec5-a374-ddd156ca7b6e\",\"StepNumber\":2,\"Text\":\"Se pun fulgii si nucile si se pulseaza pana se maruntesc. Se adauga curmalele rand pe rand si uleiul de cocos pana se formeaza o compozitie ce sta legata.\"},{\"Id\":\"81662737-66a2-419a-a15a-c4a8084457ba\",\"StepNumber\":3,\"Text\":\"Se toarna in forma si se preseaza. Se da deoparte\"},{\"Id\":\"49f2e441-4fcf-4de2-a832-e2d9e5049b45\",\"StepNumber\":4,\"Text\":\"Se mixeaza caju cu zeama de lamaie si siropul de artar.\"},{\"Id\":\"fcf68d07-9968-471d-9494-a865239d953c\",\"StepNumber\":5,\"Text\":\"Se adauga celelalte ingrediente si se mixeaza pana la omogenizare.\"},{\"Id\":\"3394f2bf-3750-4db0-970f-859c9899547c\",\"StepNumber\":6,\"Text\":\"Se toarna peste blat.\"},{\"Id\":\"09b80e9d-b9a2-45e3-9a22-1e00038b8c83\",\"StepNumber\":7,\"Text\":\"Pentru topping se face un piure de fructe.\"},{\"Id\":\"b91f95da-a781-49c5-921c-a5e6d95e3e61\",\"StepNumber\":8,\"Text\":\"Se da la congelator. Se scoate cu ceva timp inainte pentru servire.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2239068",
    "LastModified": "2026-01-12 14:15:04.2239068"
  },
  {
    "Id": "C8CF4788-82D7-4972-97C3-F494D2A69344",
    "Title": "Pancakes cu burduf, ceapa verde si marar",
    "Description": "Un mic dejun hr\u0103nitor \u0219i s\u0103n\u0103tos, ideal pentru a \u00eencepe ziua. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Pancakes_cu_burduf,_ceapa_verde_si_marar.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "Mic Dejun",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"6f6c9081-45fe-4033-b9f0-f2a8825fdfd0\",\"Name\":\"oua\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"9fdebc09-4ee4-4e6e-9d87-b0e99b78cf5d\",\"Name\":\"branza burduf\",\"Amount\":120,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"c3627c8c-f348-440e-a0f0-bc478b014c9b\",\"Name\":\"ayran (lapte cu putina zeama de lamaie)\",\"Amount\":130,\"Unit\":\"ml\",\"Order\":3},{\"Id\":\"0e3cb51c-5295-415f-8c21-626bfb2c11fd\",\"Name\":\"ulei masline\",\"Amount\":30,\"Unit\":\"ml\",\"Order\":4},{\"Id\":\"87419af2-c72d-4837-b26a-8092b54ff76b\",\"Name\":\"faina\",\"Amount\":130,\"Unit\":\"g\",\"Order\":5},{\"Id\":\"27cf4408-cedf-424b-8056-e681a052b0f2\",\"Name\":\"de copt\",\"Amount\":1,\"Unit\":\"praf\",\"Order\":6},{\"Id\":\"c03a7e9a-e23f-435e-bc85-988dd4764249\",\"Name\":\"cozi de ceapa verde\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"3bbe2599-fbdc-42b6-b0b6-9484368310ca\",\"Name\":\"marar\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8}]",
    "Instructions": "[{\"Id\":\"1486c278-041e-4ef8-8d4a-d646c5551d65\",\"StepNumber\":1,\"Text\":\"2 oua * 120g branza burduf * 130 ml ayran (lapte cu putina zeama de lamaie) * 30 ml ulei masline * 130g faina * 1 praf de copt * cozi de ceapa verde * marar\"},{\"Id\":\"f618d1a5-32b2-4e02-9bbd-202a9f33f18c\",\"StepNumber\":2,\"Text\":\"Se sfarma branza de burduf si se amesteca cu ayran-ul (laptele) si uleiul. Se adauga faina, ceapa si mararul. Nu se insista cu amestecatul, pentru a ramane o coca aerata.\"},{\"Id\":\"f93322a4-bb49-4e08-a280-c966b7458525\",\"StepNumber\":3,\"Text\":\"Se coc intr-o tigaie antiaderenta. Cand face bule se intoarce pe partea celalalta.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2239548",
    "LastModified": "2026-01-12 14:15:04.2239548"
  },
  {
    "Id": "CB8F62D2-FD4E-4F7F-92E4-7AB56799176B",
    "Title": "Tartar de pastrav",
    "Description": "Un desert delicios care combin\u0103 savoarea unic\u0103 a ingredientelor \u00eentr-o re\u021bet\u0103 rafinat\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Tartar_de_pastrav.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "Desert",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"66114959-849a-4b98-84b1-aacbb9bf5007\",\"Name\":\"file pastrav\",\"Amount\":250,\"Unit\":\"g\",\"Order\":1},{\"Id\":\"3ad71072-5737-4aa5-9bc5-5d57bc47bca6\",\"Name\":\"o ceapa rosie mica\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"7ce6b039-3972-48ca-b6dd-656dcba585fc\",\"Name\":\"capere\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":3},{\"Id\":\"28880214-2ac7-4df9-ac4f-ea7fa28bcb2c\",\"Name\":\"2-3 castraveti murati\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"4c6f266b-602b-485d-a51a-9aa836f33cfd\",\"Name\":\"o jumatate de gogosar/ardei gras rosu\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"4728cd8a-3043-4342-ba6c-634a179d790a\",\"Name\":\"ulei de masline\",\"Amount\":3,\"Unit\":\"tbsp\",\"Order\":6},{\"Id\":\"89aafcbc-8042-465b-8022-67385887c00b\",\"Name\":\"o legatura patrunjel verde\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"93ff1f99-5ba9-408d-8d06-446ccd658913\",\"Name\":\"2-3 linguri zeama de lamaie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"8f386b71-7e8d-440b-ac13-efb5a539a1ca\",\"Name\":\"sare si piper\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9}]",
    "Instructions": "[{\"Id\":\"cdc62d53-421a-4076-b472-ce31470253c1\",\"StepNumber\":1,\"Text\":\"250g file pastrav * o ceapa rosie mica * 2 linguri capere * 2-3 castraveti murati * o jumatate de gogosar/ardei gras rosu * 3 linguri ulei de masline * o legatura patrunjel verde * 2-3 linguri zeama de lamaie * sare si piper\"},{\"Id\":\"d5a28485-d77f-4900-b4ab-1a49a5ecfdbe\",\"StepNumber\":2,\"Text\":\"Scurgem bine fileul de pastrav si il taiem foarte fin. Taiem foarte marunt ceapa, gogosarul, patrunjelul, caperele, castravetele murat si le asezam pe toate intr-un bol.Acum nu ne ramane decat sa potrivim gustul tartarului de pastram, cu ulei de masline, zeama de lamaie, sare si piper dupa gust.\"},{\"Id\":\"8edda741-a424-40b7-a79f-b7f7af7c8da3\",\"StepNumber\":3,\"Text\":\"Se serveste pe paine prajita cu unt.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2240158",
    "LastModified": "2026-01-12 14:15:04.2240158"
  },
  {
    "Id": "CE3E0060-F52D-4624-A1F0-3937C0947A40",
    "Title": "Banana bread cu iaurt",
    "Description": "Un mic dejun hr\u0103nitor \u0219i s\u0103n\u0103tos, ideal pentru a \u00eencepe ziua. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Banana_bread_cu_iaurt.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "Mic Dejun",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"c5b65b3c-1dc6-4c42-b93c-4bdaec904e10\",\"Name\":\"mai mari si foarte coapte\",\"Amount\":3,\"Unit\":\"banane\",\"Order\":1},{\"Id\":\"77c8b92a-df47-421c-9a4f-874a9a48cbf9\",\"Name\":\"unt (pe care il topim)\",\"Amount\":60,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"a9f5493e-950f-43a8-8df8-0c541045ca5b\",\"Name\":\"oua\",\"Amount\":3,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"2ba528f1-db50-47a7-ba10-cdd03e062805\",\"Name\":\"iaurt \\u2013 eu am folosit Zuzu Divin cu 10% grasime\",\"Amount\":150,\"Unit\":\"g\",\"Order\":4},{\"Id\":\"27ca9cfd-2676-4fe3-834d-f3e283c625b4\",\"Name\":\"faina alba de grau\",\"Amount\":130,\"Unit\":\"g\",\"Order\":5},{\"Id\":\"800c8e86-635d-4b4f-b5de-1f22d4d7d7c0\",\"Name\":\"praf de copt\",\"Amount\":2,\"Unit\":\"tsp\",\"Order\":6}]",
    "Instructions": "[{\"Id\":\"8c3d81ad-f68c-4b81-bd43-5714fc13ccc8\",\"StepNumber\":1,\"Text\":\"3 banane mai mari si foarte coapte * 60g unt (pe care il topim) * 3 oua * 150g iaurt \\u2013 eu am folosit Zuzu Divin cu 10% grasime * 130g faina alba de grau * 2 lingurite praf de copt\"},{\"Id\":\"116f769b-d850-427f-b3f2-e7e412bd0727\",\"StepNumber\":2,\"Text\":\"Pasam bananele cu furculita pana obtinem un piure fin.\"},{\"Id\":\"c156e632-a030-42c5-a070-893cc7210d6d\",\"StepNumber\":3,\"Text\":\"Intr-un bol mixam ouale pana devin spumoase apoi adaugam pe rand untul topit, iaurtul, piureul de banane, praful de copt si faina mixand dupa fiecare pana obtinem o compozitie omogena.\"},{\"Id\":\"9e1cf3df-9aa0-4aac-b49d-f0de097054c7\",\"StepNumber\":4,\"Text\":\"Punem compozitia ideal intr-o forma de guguluf sau de chec normala.\"},{\"Id\":\"e3e0da7d-faa6-4295-b127-5c2fbfdec6d2\",\"StepNumber\":5,\"Text\":\"Coacem in cuptor la 180 grade C caldura sus-jos fara ventilatie pentru aproximativ 40 de minute sau pana se rumeneste foarte bine si trece testul cu scobitoarea.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2240158",
    "LastModified": "2026-01-12 14:15:04.2240158"
  },
  {
    "Id": "CFBA12C2-8161-45A3-92AF-1F063638FAE4",
    "Title": "Pancakes cu banane si afine",
    "Description": "Un mic dejun hr\u0103nitor \u0219i s\u0103n\u0103tos, ideal pentru a \u00eencepe ziua. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Pancakes_cu_banane_si_afine.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 1,
    "CuisineType": "Mic Dejun",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"b44cef8a-4f73-4bdb-aa0f-905c0a2a5c4b\",\"Name\":\"foarte coapte\",\"Amount\":2,\"Unit\":\"banane\",\"Order\":1},{\"Id\":\"1cc05490-7699-4617-b323-21b77713b535\",\"Name\":\"Zeama de la 1/2 l\\u0103m\\u00E2ie (sau de la 1 l\\u0103m\\u00E2ie \\u00EEntreag\\u0103 dac\\u0103 dori\\u021Bi un gust mai pronun\\u021Bat)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"cfc2d37d-c32d-4d34-892d-31f797e9ec63\",\"Name\":\"ou\\u0103\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"af7c0edc-0502-48c4-8db8-660908954361\",\"Name\":\"lingur\\u0103 ulei (eu am folosit ulei de cocos topit)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"06cdd628-d142-4e5c-882e-91a38b5aa640\",\"Name\":\"lingur\\u0103 semin\\u021Be de mac\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"58d9d0c7-82d6-450e-91d5-d295005fb145\",\"Name\":\"m\\u00E2ini fulgi de ov\\u0103z\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"b09f57f0-61e1-4166-b394-93dfdbab8882\",\"Name\":\"f\\u0103in\\u0103\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":7},{\"Id\":\"257fab5e-2674-409b-b39b-87b8c7ac22f6\",\"Name\":\"m\\u00E2ini afine\",\"Amount\":2,\"Unit\":\"buc\",\"Order\":8}]",
    "Instructions": "[{\"Id\":\"df333ecd-ea0c-43f0-b25e-952a2156721e\",\"StepNumber\":1,\"Text\":\"2 banane foarte coapte * Zeama de la 1/2 l\\u0103m\\u00E2ie (sau de la 1 l\\u0103m\\u00E2ie \\u00EEntreag\\u0103 dac\\u0103 dori\\u021Bi un gust mai pronun\\u021Bat) * 2 ou\\u0103 * 1 lingur\\u0103 ulei (eu am folosit ulei de cocos topit) * 1 lingur\\u0103 semin\\u021Be de mac * 2 m\\u00E2ini fulgi de ov\\u0103z * 2 linguri f\\u0103in\\u0103 * 2 m\\u00E2ini afine\"},{\"Id\":\"39dc5afd-2e4d-4dca-adef-2bf08ae9cf10\",\"StepNumber\":2,\"Text\":\"Pasa\\u021Bi bananele cu furculi\\u021Ba, apoi ad\\u0103uga\\u021Bi celelalte ingrediente \\u00EEn ordinea scris\\u0103 mai sus.\"},{\"Id\":\"150ef846-e9fe-4836-899f-136f22d7834a\",\"StepNumber\":3,\"Text\":\"Coace\\u021Bi cl\\u0103titele la foc mic, \\u00EEntr-o tigaie antiaderent\\u0103 \\u00EEncins\\u0103 bine.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2240958",
    "LastModified": "2026-01-12 14:15:04.2240958"
  },
  {
    "Id": "D188C095-5DC6-451E-A79F-E1C6E70FBB4D",
    "Title": "Tarta cu pere si alune de padure",
    "Description": "Un desert delicios care combin\u0103 savoarea unic\u0103 a ingredientelor \u00eentr-o re\u021bet\u0103 rafinat\u0103. Recomandat\u0103 pentru 4 por\u021bii.",
    "ImageUrl": "images/recipes/Tarta_cu_pere_si_alune_de_padure.png",
    "PrepTime": "00:20:00",
    "CookTime": "00:30:00",
    "Servings": 4,
    "Difficulty": 2,
    "CuisineType": "Desert",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"509924d2-6155-4e2a-bb23-baba1ce85afc\",\"Name\":\"f\\u0103in\\u0103 alb\\u0103 (200 g)\",\"Amount\":20,\"Unit\":\"tbsp\",\"Order\":1},{\"Id\":\"1b2da065-4421-4630-ac2c-714820b29813\",\"Name\":\"miez de alune de p\\u0103dure m\\u0103cinate\",\"Amount\":50,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"34c5242b-6386-4ece-ad60-cca27dea3272\",\"Name\":\"ou\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"3c0c5331-186b-469d-aa8b-c63bb19d4332\",\"Name\":\"6 linguri zah\\u0103r alb pudr\\u0103 (70 g)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"e91ca774-7ed3-443b-a84b-ce652b6dec54\",\"Name\":\"unt moale\",\"Amount\":150,\"Unit\":\"g\",\"Order\":5},{\"Id\":\"14c1b4b3-15d4-4c26-b464-0c13fc2279e5\",\"Name\":\"un praf de sare\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":6},{\"Id\":\"073c3a1e-7861-412a-a5aa-a8e095a8ac2f\",\"Name\":\"zah\\u0103r brun (200 g)\",\"Amount\":12,\"Unit\":\"tbsp\",\"Order\":7},{\"Id\":\"e22a3b7a-119e-43d3-862f-9ccdd9d2c2ba\",\"Name\":\"zeama de la 1/2 l\\u0103m\\u0203ie mic\\u0103\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"1dbc0127-973f-446c-8f4f-9d894d0a6d90\",\"Name\":\"c\\u0203teva buc\\u0103\\u0163i de anason\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"22d7171b-11ef-4386-9aa2-9e1d23d961aa\",\"Name\":\"800-900 g pere tari, de m\\u0103rime medie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":10},{\"Id\":\"007e1f65-6cb1-414f-a39c-6208e7c43b23\",\"Name\":\"unt moale\",\"Amount\":150,\"Unit\":\"g\",\"Order\":11},{\"Id\":\"fc3a94d9-f5e0-4487-a407-43ac6e25dca5\",\"Name\":\"zah\\u0103r alb pudr\\u0103 (150 g)\",\"Amount\":12,\"Unit\":\"tbsp\",\"Order\":12},{\"Id\":\"1c73df54-6464-4750-8246-7b59cf5fd314\",\"Name\":\"ou\\u0103 de cas\\u0103, la temperatura camerei\",\"Amount\":3,\"Unit\":\"buc\",\"Order\":13},{\"Id\":\"27ed467e-f63d-4a74-9aac-c1c86744c428\",\"Name\":\"f\\u0103in\\u0103 alb\\u0103 (70 g)\",\"Amount\":7,\"Unit\":\"tbsp\",\"Order\":14},{\"Id\":\"61130232-723f-43a3-8497-2d977a51e299\",\"Name\":\"miez de alune de p\\u0103dure coapte, plus c\\u0203teva alune pentru umplerea perelor\",\"Amount\":100,\"Unit\":\"g\",\"Order\":15},{\"Id\":\"0ca9764d-83d4-49cb-9229-30ba12433cdb\",\"Name\":\"linguri\\u0163\\u0103 pudr\\u0103 de ghimbir\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":16}]",
    "Instructions": "[{\"Id\":\"521ebc7d-3b3f-4efa-8324-7b595b28288a\",\"StepNumber\":1,\"Text\":\"Ingrediente aluat * 20 linguri f\\u0103in\\u0103 alb\\u0103 (200 g) * 50 g miez de alune de p\\u0103dure m\\u0103cinate * 1 ou * 6 linguri zah\\u0103r alb pudr\\u0103 (70 g) * 150 g unt moale * un praf de sare Ingrediente umplutura * 12 linguri zah\\u0103r brun (200 g) * zeama de la 1/2 l\\u0103m\\u0203ie mic\\u0103 * c\\u0203teva buc\\u0103\\u0163i de anason * 800-900 g pere tari, de m\\u0103rime medie * 150 g unt moale * 12 linguri zah\\u0103r alb pudr\\u0103 (150 g) * 3 ou\\u0103 de cas\\u0103, la temperatura camerei * 7 linguri f\\u0103in\\u0103 alb\\u0103 (70 g) * 100 g miez de alune de p\\u0103dure coapte, plus c\\u0203teva alu...\"},{\"Id\":\"3fb8130b-4512-4af1-8350-9e1272d343ff\",\"StepNumber\":2,\"Text\":\"Preparare aluat** Alunele se coc 5-7 minute la 180 grade si se macina fin. Untul moale si zaharul se mixeaza bine, apoi se incorporeaza oul batut cu furculita, faina, sarea si alunele. Aluatul obtinut se pune intr-o folie alimentara la frigider pentru cel putin 45\\u0027. Aluatul se intinde intre 2 foi de copt si se aseaza intr-o tava de 22cm diametru si 7cm inaltime. Se baga din nou la frigider pentru 30\\u0027.\"},{\"Id\":\"8c58824c-c750-4c69-afc8-89ab436958a1\",\"StepNumber\":3,\"Text\":\"Aluatul se coace in cuptorul preincalzit la 200 grade. Se aseaza peste el o foaie de copt si boabe de fasole pentru a nu se umfla. Se coace asa timp de 20\\u0027, apoi se da la o parte folia si se mai coace 5\\u0027.\"},{\"Id\":\"1c57ea9c-17b0-4d93-aff7-36924a4ca57e\",\"StepNumber\":4,\"Text\":\"Pregatire pere** Perele se curata de coaja si de cotor, fara a se rupe coditele. Se pune la fiert 1 litru de apa in care se dizolva 200gr zahar brun, cu anason si zeama de lamaie. Se poseaza perele timp de 5 minute dupa care se racesc si se pun in frigider. Din lichid se iau 400ml si se fierbe pana se reduce suficient.\"},{\"Id\":\"bccc1bba-a110-4248-a34a-059b1510b944\",\"StepNumber\":5,\"Text\":\"Preparare umplutura** Se mixeaza untul si zaharul pudra, dupa care se incorporeaza treptat ouale batute cu furculita, apoi faina, ghimbirul si alunele tocate grosier. O parte din aluat se pune in tava si se niveleaza (1-2cm) Peste se adauga perele care au fost umplute cu alune oparite. Se aseaza restul de umplutura si se da tava la cuptor pentru 45\\u0027 la 200 grade C. Este gata cand trece testul scobitorii. Siropul usor incalzit se toarna peste tarta fierbinte. Dupa ce s-a racit se scoate din fo...\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2241543",
    "LastModified": "2026-01-12 14:15:04.2241543"
  },
  {
    "Id": "D325ED03-AD6D-48BC-B981-590A77B5B8EC",
