    "CuisineType": "Mic Dejun",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"e499a6c3-6270-47cf-911b-00a0945f5e37\",\"Name\":\"Aluat**:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"f0c4e2ae-ab41-4b1b-8d3b-e9e1c29a5868\",\"Name\":\"faina pt paine\",\"Amount\":250,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"1ec23ecb-e479-4666-93a2-52dbd45d052b\",\"Name\":\"lapte caldut\",\"Amount\":100,\"Unit\":\"g\",\"Order\":3},{\"Id\":\"6a174764-0cfe-42fd-86a1-8abc8dc287c4\",\"Name\":\"iaurt gras\",\"Amount\":60,\"Unit\":\"g\",\"Order\":4},{\"Id\":\"82854ff9-86a0-4be0-aa84-01d324327bf7\",\"Name\":\"drojdie uscat\\u0103\",\"Amount\":5,\"Unit\":\"g\",\"Order\":5},{\"Id\":\"75fabc68-011e-413d-87fa-017fa304331f\",\"Name\":\"ulei de m\\u0103sline extra-virgin\",\"Amount\":10,\"Unit\":\"g\",\"Order\":6},{\"Id\":\"2328f846-0033-49b5-b20f-8ef5264b0009\",\"Name\":\"usturoi granulat (optional)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":7},{\"Id\":\"035623b4-f180-4cad-b8b6-7eff69abe499\",\"Name\":\"Umplutur\\u0103** :\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"10ca8550-cb37-4d27-9a3d-e537523c58a2\",\"Name\":\"Br\\u00E2nz\\u0103 la alegere, ras\\u0103 sau sf\\u0103r\\u00E2mat\\u0103\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":9},{\"Id\":\"3d33bb0a-661b-4ac0-9512-9b37ce24f568\",\"Name\":\"Patrunjel verde\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":10},{\"Id\":\"34dc4ac6-338e-47b3-a82c-abe92f53a6b7\",\"Name\":\"Pt uns:\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":11},{\"Id\":\"aabec8f7-b8b5-4435-8724-630db30a5362\",\"Name\":\"Unt topit\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":12},{\"Id\":\"57434a1f-a0a1-472e-939d-06b39107a135\",\"Name\":\"Usturoi pisat\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":13},{\"Id\":\"2055cbbe-fbbe-4a9f-a455-98fb8301ef6f\",\"Name\":\"Patrunjel verde\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":14}]",
    "Instructions": "[{\"Id\":\"98868190-f748-461a-a8c8-4028e58262b9\",\"StepNumber\":1,\"Text\":\"Aluat**: 250g faina pt paine 100g lapte caldut 60g iaurt gras 5g drojdie uscat\\u0103 10g ulei de m\\u0103sline extra-virgin usturoi granulat (optional) **Umplutur\\u0103** : Br\\u00E2nz\\u0103 la alegere, ras\\u0103 sau sf\\u0103r\\u00E2mat\\u0103 Patrunjel verde **Pt uns:** Unt topit Usturoi pisat Patrunjel verde\"},{\"Id\":\"e2bd28e3-4383-44f8-b652-f7f6cd9d7913\",\"StepNumber\":2,\"Text\":\"Se fr\\u0103m\\u00E2nt\\u0103 un aluat elastic \\u0219i nelipicios care se las\\u0103 la dospit pana \\u00EE\\u0219i dubleaz\\u0103 volumul.\"},{\"Id\":\"049aa521-9af6-4001-b3b8-13b4ae07428b\",\"StepNumber\":3,\"Text\":\"Se \\u00EEmparte \\u00EEn 8 bile egale ( sau 4 dac\\u0103 le vre\\u021Bi mai mari) \\u0219i se las\\u0103 din nou la dospit 30 min acoperite cu un prosop sa nu se usuce.\"},{\"Id\":\"d3d234b7-b061-4e71-996e-c75bee6c3cad\",\"StepNumber\":4,\"Text\":\"Se \\u00EEntinde sub\\u021Bire fiecare bila, se \\u00EEntinde pe jum\\u0103tate ni\\u0219te umplutura dup\\u0103 care se impatura.\"},{\"Id\":\"93f462f1-19bf-4044-8dd9-adf5402b6a84\",\"StepNumber\":5,\"Text\":\"Se pr\\u0103jesc \\u00EEn tigaia \\u00EEncins\\u0103 pe foc mediu, pana se rumenesc pe ambele p\\u0103r\\u021Bi. Cum se g\\u0103tesc se ung cu amestecul de unt \\u0219i se suprapun sub un prosop.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2107158",
    "LastModified": "2026-01-12 14:15:04.2107158"
  },
  {
    "Id": "0C1CE885-02BE-4576-B61A-C80A706136E0",
