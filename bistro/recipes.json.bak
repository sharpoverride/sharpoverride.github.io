    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"44caaaea-7516-4bf6-91fc-f6b78804f863\",\"Name\":\"biscuiti dati pe razatoare (sfarmati)\",\"Amount\":500,\"Unit\":\"g\",\"Order\":1},{\"Id\":\"a3ede37c-bf01-4122-9c29-8cb6aab70801\",\"Name\":\"nuca macinata\",\"Amount\":200,\"Unit\":\"g\",\"Order\":2},{\"Id\":\"1a34d242-8940-4b50-8140-60c66e8f666f\",\"Name\":\"de margarina\",\"Amount\":1,\"Unit\":\"pachet\",\"Order\":3},{\"Id\":\"039cb9cf-7b3e-4665-afdd-adc8619a76cc\",\"Name\":\"- 300 ml lapte\",\"Amount\":250,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"a39c1614-b90c-4ea3-8ed8-9036dc904f66\",\"Name\":\"esenta de rom\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5},{\"Id\":\"6cccb4b3-4d2d-478c-8004-8d4a2eb2ff72\",\"Name\":\"cacao\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":6}]",
    "Instructions": "[{\"Id\":\"53b282a1-3409-4e61-a51e-7e59529e134e\",\"StepNumber\":1,\"Text\":\"500 gr biscuiti dati pe razatoare (sfarmati)\"},{\"Id\":\"4acc9ea3-829a-4a13-ae79-6c5910519cd1\",\"StepNumber\":2,\"Text\":\"1 pachet de margarina\"},{\"Id\":\"450d53e5-9d69-4dea-ae0d-19dae420db09\",\"StepNumber\":3,\"Text\":\"Margarina se topeste si se adauga peste celelalte ingrediente. Se amesteca pana la omogenizare si se pun intr-un celofan invartindu-se.\"}]",
