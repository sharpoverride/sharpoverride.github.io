    "Ingredients": "[{\"Id\":\"27a0e3d8-6ceb-4458-8e9e-acc00694ce2b\",\"Name\":\"\\u2013 250ml lapte\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"8883aa3b-b862-4029-bb07-33d4d6deac0c\",\"Name\":\"\\u2013 4 linguri seminte de chia\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"9c1d0b59-955e-41b5-9f45-1b06e5ab3511\",\"Name\":\"\\u2013 2 linguri miere\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"8d060024-b65a-418b-aaed-175fa995f689\",\"Name\":\"\\u2013 o lingurita extract de vanilie/o jumatate de pastaie de vanilie\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"783c45a7-01d7-4d47-9ceb-5594a078ed75\",\"Name\":\"\\u2013 zmeura/fructe proaspete pentru decor\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5}]",
    "Instructions": "[{\"Id\":\"45d5251b-353e-4d35-ae3d-0d61d1e6983f\",\"StepNumber\":1,\"Text\":\"Ingrediente pentru 2 portii:** \\u2013 250ml lapte \\u2013 4 linguri seminte de chia \\u2013 2 linguri miere \\u2013 o lingurita extract de vanilie/o jumatate de pastaie de vanilie \\u2013 zmeura/fructe proaspete pentru decor\"}]",
