    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"03d6da97-d7f2-4e66-b1fc-7fc3b8f9af0b\",\"Name\":\"mascarpone\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":1},{\"Id\":\"618b524d-f8c4-4c06-9793-987709121efc\",\"Name\":\"ricotta\",\"Amount\":2,\"Unit\":\"tbsp\",\"Order\":2},{\"Id\":\"040f19ad-28c6-485c-aaad-3d63ab8e49d5\",\"Name\":\"c\\u0103p\\u015Funi mari\",\"Amount\":10,\"Unit\":\"buc\",\"Order\":3},{\"Id\":\"812dde2b-300d-497e-955f-0e09a754f1c4\",\"Name\":\"banan\\u0103 bine coapt\\u0103\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"9b2fb4a3-3f59-47f7-9078-9599fc9cc825\",\"Name\":\"A\\u015Fa cum v-a\\u0163i dat seama, aceast\\u0103 re\\u0163et\\u0103 nu are nimic complicat. C\\u0103p\\u015Funile le-am sp\\u0103lat bine \\u015Fi le-am cur\\u0103\\u0163at. Le-am t\\u0103iat \\u00EEn 4 \\u015Fi le-am pus \\u00EEn blender al\\u0103turi de mascarpone, ricotta \\u015Fi banana bine coapt\\u0103. Le-am mixat p\\u00E2n\\u0103 am ob\\u015Finut o crem\\u0103/spum\\u0103 fin\\u0103.\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":5}]",
    "Instructions": "[{\"Id\":\"eaa22b58-39b0-4d79-8b5a-d4d33f100fbc\",\"StepNumber\":1,\"Text\":\"2 linguri mascarpone * 2 linguri ricotta * 10 c\\u0103p\\u015Funi mari * 1 banan\\u0103 bine coapt\\u0103 A\\u015Fa cum v-a\\u0163i dat seama, aceast\\u0103 re\\u0163et\\u0103 nu are nimic complicat. C\\u0103p\\u015Funile le-am sp\\u0103lat bine \\u015Fi le-am cur\\u0103\\u0163at. Le-am t\\u0103iat \\u00EEn 4 \\u015Fi le-am pus \\u00EEn blender al\\u0103turi de mascarpone, ricotta \\u015Fi banana bine coapt\\u0103. Le-am mixat p\\u00E2n\\u0103 am ob\\u015Finut o crem\\u0103/spum\\u0103 fin\\u0103.\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2152437",
    "LastModified": "2026-01-12 14:15:04.2152437"
  },
