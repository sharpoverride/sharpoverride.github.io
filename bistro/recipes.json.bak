    "CuisineType": "General\u0103",
    "IsFavorite": 0,
    "Ingredients": "[{\"Id\":\"460eda18-ef43-44d9-a3a3-d3a25d2a347c\",\"Name\":\"salata romaine sau salata iceberg\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":1},{\"Id\":\"325864d0-0365-462a-a845-958b6968d4f6\",\"Name\":\"crutoane (paine, sare, piper, ulei, usturoi granule)\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":2},{\"Id\":\"893adfc1-5ab1-4ca0-9522-f75f5f024bf5\",\"Name\":\"de pui preparat la cuptor\",\"Amount\":1,\"Unit\":\"piept\",\"Order\":3},{\"Id\":\"ff56186e-1f88-45fe-b416-c8663e653106\",\"Name\":\"Dressing\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":4},{\"Id\":\"93d3fcfa-ab4c-466e-9320-0cc4de70cfab\",\"Name\":\"(eu inlocuiesc cu avocado)\",\"Amount\":1,\"Unit\":\"galbenus\",\"Order\":5},{\"Id\":\"71e94acf-8be4-4c67-ae0b-2eabb3630e29\",\"Name\":\"mustar simplu\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":6},{\"Id\":\"1296f617-0d00-4da9-ad77-784678a25304\",\"Name\":\"zeama de lamaie\",\"Amount\":15,\"Unit\":\"ml\",\"Order\":7},{\"Id\":\"69241cdf-b706-4df8-b477-acf809ff95ff\",\"Name\":\"4-5 fileuri ansoa\",\"Amount\":1,\"Unit\":\"buc\",\"Order\":8},{\"Id\":\"0ee990f6-e41e-4d01-ae3e-da652571c1b0\",\"Name\":\"sos Worchester\",\"Amount\":1,\"Unit\":\"tbsp\",\"Order\":9},{\"Id\":\"2f693836-f77b-4f25-a212-5c592ec069c1\",\"Name\":\"usturoi\",\"Amount\":1,\"Unit\":\"catel\",\"Order\":10},{\"Id\":\"f15e7d2e-d719-4671-9b24-a667177030db\",\"Name\":\"ulei de masline\",\"Amount\":50,\"Unit\":\"ml\",\"Order\":11},{\"Id\":\"db945e74-7720-4f75-ad3c-f7434f6d0bc1\",\"Name\":\"- 40gr parmezan\",\"Amount\":30,\"Unit\":\"buc\",\"Order\":12}]",
    "Instructions": "[{\"Id\":\"b074d794-f15d-4e5b-8ae8-099c1f7608e6\",\"StepNumber\":1,\"Text\":\"salata romaine sau salata iceberg * crutoane (paine, sare, piper, ulei, usturoi granule) * 1 piept de pui preparat la cuptor Dressing * 1 galbenus (eu inlocuiesc cu avocado) * 1 lg mustar simplu * 15 ml zeama de lamaie * 4-5 fileuri ansoa * 1 lg sos Worchester * 1 catel usturoi * 50 ml ulei de masline * 30 - 40gr parmezan\"},{\"Id\":\"c39d93f6-3248-4661-942d-9386f110e1c3\",\"StepNumber\":2,\"Text\":\"Se prepara puiul [[Piept de pui la cuptor]] , crutoanele\"},{\"Id\":\"d6888bfe-d922-4315-911f-1c440f2d31e0\",\"StepNumber\":3,\"Text\":\"Se spala salata, se pregateste deresingul si se amesteca toate\"}]",
    "ExportedAt": "2026-01-12 14:15:04.2209978",
    "LastModified": "2026-01-12 14:15:04.2209978"
  },
  {
